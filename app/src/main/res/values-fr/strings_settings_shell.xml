    <string name="settings_shell_modal_media_relocation_leave">Laisser</string>

    <string name="settings_shell_modal_jellyfin_signout_title">Se déconnecter de Jellyfin ?</string>
    <string name="settings_shell_modal_jellyfin_signout_message">Cet appareil oublie votre connexion Jellyfin. Les médias téléchargés restent sur le disque et votre historique de visionnage reste sur le serveur.</string>
    <string name="settings_shell_modal_jellyfin_signout_confirm">Se déconnecter</string>

    <string name="settings_shell_modal_import_settings_title">Importer les réglages ?</string>
    <string name="settings_shell_modal_import_settings_message">Choisissez un fichier de sauvegarde et les réglages qu\'il contient remplaceront les vôtres. Tout ce que le fichier omet reste inchangé, et les comptes, serveurs, états de synchro et emplacements de fichiers ne sont jamais repris.</string>
    <string name="settings_shell_modal_import_settings_confirm">Choisir un fichier</string>

    <string name="settings_shell_modal_migrate_downloads_title">Migrer les téléchargements ?</string>
    <string name="settings_shell_modal_migrate_downloads_message">Déplacer %1$d jeux (%2$s) vers le nouvel emplacement ?</string>
    <string name="settings_shell_modal_migrate_downloads_confirm">Migrer</string>
    <string name="settings_shell_modal_migrate_downloads_skip">Ignorer</string>

    <string name="settings_shell_modal_migrate_platform_title">Migrer les ROM %1$s ?</string>
    <string name="settings_shell_modal_migrate_platform_fallback">Plateforme</string>
    <string name="settings_shell_modal_migrate_platform_message">Déplacer les jeux téléchargés vers le nouvel emplacement ? Les fichiers seront copiés puis supprimés de l\'ancien emplacement.</string>
    <string name="settings_shell_modal_migrate_platform_confirm">Migrer</string>
    <string name="settings_shell_modal_migrate_platform_skip">Ignorer</string>

    <string name="settings_shell_modal_purge_platform_title">Purger %1$s ?</string>
    <string name="settings_shell_modal_purge_platform_fallback">Plateforme</string>
    <string name="settings_shell_modal_purge_platform_message">Cela supprimera les %1$d jeux et leurs fichiers ROM locaux. Cette action est irréversible.</string>
    <string name="settings_shell_modal_purge_platform_confirm">Purger</string>

    <string name="settings_shell_modal_sync_first_title">Synchroniser les sauvegardes d\'abord</string>
    <string name="settings_shell_modal_sync_first_message">Synchronisez les sauvegardes d\'abord : %1$d en attente. Réinitialiser la bibliothèque maintenant supprimerait définitivement les sauvegardes non envoyées.</string>
    <string name="settings_shell_modal_sync_first_confirm">Synchroniser</string>

    <string name="settings_shell_modal_reset_library_title">Réinitialiser la bibliothèque ?</string>
    <string name="settings_shell_modal_reset_library_message">Efface la base de données et le cache d\'images. Les fichiers téléchargés restent sur le disque. Perdus définitivement : le temps de jeu, les collections locales, l\'historique des téléchargements, l\'état de synchro des sauvegardes et les réglages par jeu. Vous devrez resynchroniser votre bibliothèque.</string>
    <string name="settings_shell_modal_reset_library_confirm">Réinitialiser</string>

