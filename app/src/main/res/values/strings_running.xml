<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Owner: ui/screens/running
      Key prefix: running_
      Keys are named for the usage site, never for the English text, and identical English
      is never shared between two usage sites.
    -->

    <!-- Drawer row leading to the games and apps left open in the background, where the player
         picks one to go back to. Verb used as a page name: to resume play. -->
    <string name="running_drawer_title">Resume</string>
    <!-- Heading over the games and apps left open in the background. Same meaning as the
         drawer row: to resume play. -->
    <string name="running_header_title">Resume</string>
    <!-- Shown in place of the list when no other app has a task open. -->
    <string name="running_empty_title">Nothing else is running</string>
    <!-- Memory the app is using, in megabytes. %1$d is a whole number. -->
    <string name="running_row_memory">%1$d MB</string>
    <!-- Which display the app is on, on a device with more than one. %1$d is the number drawn
         on that screen. -->
    <string name="running_row_screen">Screen %1$d</string>

    <!-- Context menu entry that brings the app back to the front. Verb. -->
    <string name="running_menu_switch_to">Switch To</string>
    <!-- Context menu entry that stops the app. Verb: to close an app. -->
    <string name="running_menu_close">Close</string>

    <!-- Footer hint for the button that stops the focused app. Verb: to close an app. -->
    <string name="running_hint_close">Close</string>
    <!-- Footer hint for the button that stops every app in the list. Verb: to close all apps. -->
    <string name="running_hint_close_all">Close All</string>

    <!-- Title of the prompt before stopping an emulator that still holds a game. %1$s is the
         game title. Verb: to close the game. -->
    <string name="running_confirm_close_title">Close %1$s?</string>
    <!-- Body of the prompt before stopping an emulator that still holds a game. -->
    <string name="running_confirm_close_message">Unsaved progress is lost.</string>
    <!-- Confirm button of the prompt before stopping a game. Verb: to close the game. -->
    <string name="running_confirm_close_confirm">Close</string>
    <!-- Title of the prompt before stopping every app in the list. -->
    <string name="running_confirm_close_all_title">Close everything?</string>
    <!-- Body of the prompt before stopping every app in the list. -->
    <string name="running_confirm_close_all_message">Every app in this list is stopped. Unsaved progress in any game is lost.</string>
    <!-- Confirm button of the prompt before stopping every app. Verb: to close all apps. -->
    <string name="running_confirm_close_all_confirm">Close All</string>

    <!-- Error shown when the system refuses to bring an app forward. %1$s is the app name. -->
    <string name="running_notice_switch_failed">Could not switch to %1$s</string>

    <!-- Play time of a game since it was started, shown beside a clock icon on its card. Hours
         and minutes, h and m being the unit abbreviations. -->
    <string name="running_card_time_hours_minutes">%1$dh %2$dm</string>
    <!-- Play time of a game since it was started, shown beside a clock icon on its card. Minutes
         and seconds, m and s being the unit abbreviations. -->
    <string name="running_card_time_minutes_seconds">%1$dm %2$ds</string>
    <!-- Play time of a game since it was started, shown beside a clock icon on its card. Seconds,
         s being the unit abbreviation. -->
    <string name="running_card_time_seconds">%1$ds</string>
    <!-- When the focused game last saved. %1$s is a relative time such as "4m ago". -->
    <string name="running_card_saved">Saved %1$s</string>
    <!-- Achievements earned out of the game's total. -->
    <string name="running_card_ra_progress" translatable="false">%1$d/%2$d</string>
    <!-- Tag beside the achievement count when the game runs under RetroAchievements hardcore
         rules. Hardcore is the RetroAchievements mode name. -->
    <string name="running_card_ra_hardcore">Hardcore</string>
    <!-- Shown over a card while its game saves before closing. Verb in progress. -->
    <string name="running_card_saving">Saving</string>
    <!-- Shown over a card once its game has closed. -->
    <string name="running_card_closed">Closed</string>
    <!-- Count of friends beyond the avatars shown. -->
    <string name="running_friends_more" translatable="false">+%1$d</string>
    <!-- Line under the focused game naming the one friend playing the same game now. -->
    <string name="running_friends_one">%1$s is playing this</string>
    <!-- Same line for two friends. -->
    <string name="running_friends_two">%1$s and %2$s are playing this</string>
    <!-- Same line for three friends. -->
    <string name="running_friends_three">%1$s, %2$s and %3$s are playing this</string>
    <!-- Same line for four or more friends: three named, the rest summarised. -->
    <string name="running_friends_many">%1$s, %2$s, %3$s and others are playing this</string>
</resources>
