    <string name="settings_shell_modal_builtin_migration_skip">Пропустить</string>

    <string name="settings_shell_modal_music_relocation_title">Переместить музыкальные файлы?</string>
    <string name="settings_shell_modal_music_relocation_message">Текущая папка с музыкой содержит %1$d файлов. Переместить их в новое расположение? Конфликты будут перезаписаны.</string>
    <string name="settings_shell_modal_music_relocation_confirm">Переместить</string>
    <string name="settings_shell_modal_music_relocation_skip">Пропустить</string>

    <string name="settings_shell_modal_media_relocation_title">Переместить скачанные медиа?</string>
    <string name="settings_shell_modal_media_relocation_message">Текущая папка с медиа содержит %1$d файлов. Переместить их в новое расположение? Конфликты будут перезаписаны.</string>
    <string name="settings_shell_modal_media_relocation_confirm">Переместить</string>
    <string name="settings_shell_modal_media_relocation_leave">Оставить</string>

    <string name="settings_shell_modal_jellyfin_signout_title">Выйти из Jellyfin?</string>
    <string name="settings_shell_modal_jellyfin_signout_message">Это устройство забудет вход в Jellyfin. Скачанные медиа останутся на диске, а история просмотра - на сервере.</string>
    <string name="settings_shell_modal_jellyfin_signout_confirm">Выйти</string>

    <string name="settings_shell_modal_import_settings_title">Импортировать настройки?</string>
    <string name="settings_shell_modal_import_settings_message">Выберите файл резервной копии - указанные в нём настройки заменят ваши. Всё, что в файле не указано, останется без изменений; аккаунты, серверы, статус синхронизации и расположения файлов никогда не переносятся.</string>
    <string name="settings_shell_modal_import_settings_confirm">Выбрать файл</string>

    <string name="settings_shell_modal_migrate_downloads_title">Перенести загрузки?</string>
    <string name="settings_shell_modal_migrate_downloads_message">Переместить %1$d игр (%2$s) в новое расположение?</string>
    <string name="settings_shell_modal_migrate_downloads_confirm">Перенести</string>
    <string name="settings_shell_modal_migrate_downloads_skip">Пропустить</string>

    <string name="settings_shell_modal_migrate_platform_title">Перенести ROM %1$s?</string>
    <string name="settings_shell_modal_migrate_platform_fallback">Платформа</string>
    <string name="settings_shell_modal_migrate_platform_message">Переместить скачанные игры в новое расположение? Файлы будут скопированы, а затем удалены из старого расположения.</string>
    <string name="settings_shell_modal_migrate_platform_confirm">Перенести</string>
    <string name="settings_shell_modal_migrate_platform_skip">Пропустить</string>

    <string name="settings_shell_modal_purge_platform_title">Очистить %1$s?</string>
    <string name="settings_shell_modal_purge_platform_fallback">Платформа</string>
    <string name="settings_shell_modal_purge_platform_message">Это удалит все %1$d игр и их локальные файлы ROM. Действие необратимо.</string>
    <string name="settings_shell_modal_purge_platform_confirm">Очистить</string>

    <string name="settings_shell_modal_sync_first_title">Сначала синхронизируйте сохранения</string>
    <string name="settings_shell_modal_sync_first_message">Сначала синхронизируйте сохранения - %1$d в ожидании. Сброс библиотеки сейчас безвозвратно удалит невыгруженные сохранения.</string>
    <string name="settings_shell_modal_sync_first_confirm">Синхронизировать</string>

    <string name="settings_shell_modal_reset_library_title">Сбросить библиотеку?</string>
    <string name="settings_shell_modal_reset_library_message">Очищает базу данных и кэш изображений. Скачанные файлы останутся на диске. Будут безвозвратно потеряны: время игры, локальные коллекции, история загрузок, статус синхронизации сохранений и настройки отдельных игр. Библиотеку потребуется синхронизировать заново.</string>
    <string name="settings_shell_modal_reset_library_confirm">Сбросить</string>

