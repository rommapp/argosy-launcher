{
  "id": "latin-qwertz",
  "version": 1,
  "script": "Latn",
  "locales": ["de"],
  "composer": "none",
  "pages": {
    "letters": {
      "shift": "upper",
      "rows": [
        [{"k": "1", "s": "!"}, {"k": "2", "s": "@"}, {"k": "3", "s": "#"}, {"k": "4", "s": "$"}, {"k": "5", "s": "%"}, {"k": "6", "s": "^"}, {"k": "7", "s": "&"}, {"k": "8", "s": "*"}, {"k": "9", "s": "("}, {"k": "0", "s": ")"}],
        ["q", "w", "e", "r", "t", "z", "u", "i", "o", "p", "ü"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l", "ö", "ä"],
        [{"fn": "shift", "w": 2}, "y", "x", "c", "v", "b", "n", "m", {"fn": "backspace", "w": 2}]
      ]
    },
    "symbols": {"ref": "shared-symbols", "asciiOnly": true}
  },
  "accents": {
    "a": ["ä", "à", "á", "â", "æ", "ã", "å", "ā"],
    "e": ["é", "è", "ê", "ë", "ē", "ė", "ę"],
    "c": ["ç", "ć", "č"],
    "n": ["ñ", "ń"],
    "s": ["ß", "ś", "š"],
    "i": ["ì", "í", "î", "ï", "ī", "į", "ı"],
    "o": ["ö", "ò", "ó", "ô", "õ", "ø", "ō", "œ", "ő"],
    "u": ["ü", "ù", "ú", "û", "ū", "ů", "ű"],
    "y": ["ý", "ÿ"],
    "z": ["ž", "ź", "ż"],
    "l": ["ł", "ľ", "ĺ"],
    "g": ["ğ"],
    "d": ["ď", "đ", "ð"],
    "r": ["ř", "ŕ"],
    "t": ["ť", "þ"],
    "$": ["€", "£", "¥", "₹", "₩", "₽"]
  },
  "accentDefault": {
    "de": {"s": "ß"}
  }
}
