    <string name="settings_shell_modal_romm_signout_title">要登出RomM嗎？</string>
    <plurals name="settings_shell_romm_signout_pending_message">
        <item quantity="other">%1$d個存檔會先上傳。全部同步到伺服器後，此帳號在此裝置上快取的存檔、即時存檔與設定會被移除，已下載的遊戲則會保留。</item>
    </plurals>
    <string name="settings_shell_romm_signout_message">此帳號在此裝置上快取的存檔、即時存檔與設定會被移除，已上傳的內容會保留在伺服器上，已下載的遊戲則會保留。</string>
    <string name="settings_shell_modal_romm_signout_confirm">登出</string>

    <string name="settings_shell_modal_reset_save_cache_title">要重設存檔快取嗎？</string>
    <string name="settings_shell_modal_reset_save_cache_message">這會刪除所有本機快取的存檔快照與待處理的同步作業，不會影響您實際的存檔檔案與伺服器上的存檔。</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">重設</string>

    <string name="settings_shell_modal_clear_save_path_cache_title">要清除存檔路徑快取嗎？</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">這會清除所有偵測到的存檔路徑，下次同步時會重新偵測。若存檔同步到錯誤的位置，可使用此功能。</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">清除</string>

    <string name="settings_shell_modal_secure_saves_off_title">要關閉安全存檔嗎？</string>
    <string name="settings_shell_modal_secure_saves_off_message">關閉此功能會停用RetroAchievements的硬核模式。在重新開啟安全存檔之前，遊戲會以一般模式啟動。</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">關閉</string>

    <string name="settings_shell_modal_clear_state_cache_title">要清除即時存檔快取嗎？</string>
    <string name="settings_shell_modal_clear_state_cache_message">這會刪除所有本機快取的即時存檔快照與待處理的同步作業，不會影響存檔檔案與伺服器上的副本。</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">清除</string>

    <string name="settings_shell_modal_caches_clear_confirm">清除</string>

