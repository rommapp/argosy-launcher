    <string name="collections_detail_hint_open">Open</string>
    <string name="collections_detail_hint_back">Back</string>
    <!-- Footer hint. Verb: open search. -->
    <string name="collections_detail_hint_search">Search</string>
    <string name="collections_detail_hint_unpin">Unpin</string>
    <string name="collections_detail_hint_pin">Pin</string>
    <!-- Footer hint. Verb: jump between alphabet sections. -->
    <string name="collections_detail_hint_jump">Jump</string>
    <string name="collections_detail_hint_options">Options</string>
    <string name="collections_detail_hint_refreshing">Refreshing&#8230;</string>
    <string name="collections_detail_hint_refresh">Refresh</string>
    <!-- Icon button. Verb: go back. -->
    <string name="collections_detail_back_description">Back</string>
    <!-- Search field placeholder; %1$s is the collection's name. -->
    <string name="collections_detail_search_placeholder">Search %1$s</string>
    <!-- Icon button. Verb: close the search field. -->
    <string name="collections_detail_close_search_description">Close search</string>
    <!-- Icon button. Verb: open the search field. -->
    <string name="collections_detail_search_description">Search</string>
    <string name="collections_detail_empty_title">No games in this collection</string>
    <string name="collections_detail_empty_subtitle">Add games from the library or game details</string>
    <!-- How many games are in the collection, shown under its name in the header. -->
    <plurals name="collections_detail_header_game_count">
        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>

    <!-- === VirtualBrowserScreen.kt === -->
    <string name="collections_browser_loading">Loading&#8230;</string>
    <!-- Footer hint, search active. Verb: open the focused category. -->
    <string name="collections_browser_hint_search_select">Select</string>
    <string name="collections_browser_hint_search_close">Close Search</string>
    <string name="collections_browser_hint_navigate">Navigate</string>
    <!-- Footer hint, search inactive. Verb: open the focused category. -->
    <string name="collections_browser_hint_select">Select</string>
    <string name="collections_browser_hint_back">Back</string>
    <string name="collections_browser_hint_search">Search</string>
    <string name="collections_browser_hint_unpin">Unpin</string>
    <string name="collections_browser_hint_pin">Pin</string>
    <string name="collections_browser_hint_jump">Jump</string>
    <string name="collections_browser_hint_refreshing">Refreshing&#8230;</string>
    <string name="collections_browser_hint_refresh">Refresh</string>
    <string name="collections_browser_back_description">Back</string>
    <!-- Search field placeholder; %1$s is the browse-by screen's title (for example "Genres"). -->
    <string name="collections_browser_search_placeholder">Search %1$s</string>
    <string name="collections_browser_close_search_description">Close search</string>
    <string name="collections_browser_search_description">Search</string>
    <!-- Icon description for the pin badge on a pinned category row. Adjective, not the verb
         "to pin". Distinct key from collections_pinned_description (different usage site). -->
    <string name="collections_browser_category_pinned_description">Pinned</string>
    <!-- Fallback screen title if a browse-by type is ever unrecognized; should not occur in
         normal use. -->
    <string name="collections_browser_title_fallback">Browse</string>
    <!-- "No <type> found", where %1$s is the already-localized browse-by title, for example
         "No Genres found". -->
    <string name="collections_browser_empty">No %1$s found</string>
    <!-- How many categories exist under this browse-by type, shown in the header subtitle. -->
    <plurals name="collections_browser_header_category_count">
        <item quantity="one">%d category</item>
        <item quantity="other">%d categories</item>
    </plurals>
    <!-- How many games are in one category row. -->
    <plurals name="collections_browser_row_game_count">
        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>

    <!-- === VirtualCategoryScreen.kt === -->
    <string name="collections_category_loading">Loading&#8230;</string>
    <string name="collections_category_hint_search_open">Open</string>
    <string name="collections_category_hint_search_close">Close Search</string>
    <string name="collections_category_hint_navigate">Navigate</string>
    <string name="collections_category_hint_open">Open</string>
    <string name="collections_category_hint_back">Back</string>
    <string name="collections_category_hint_search">Search</string>
    <string name="collections_category_hint_unpin">Unpin</string>
    <string name="collections_category_hint_pin">Pin</string>
    <string name="collections_category_hint_jump">Jump</string>
    <string name="collections_category_hint_refreshing">Refreshing&#8230;</string>
    <string name="collections_category_hint_refresh">Refresh</string>
    <!-- Footer hint. Downloads every downloadable game in this category; %1$d is how many
