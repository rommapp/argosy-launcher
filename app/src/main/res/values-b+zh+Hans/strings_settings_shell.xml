    <string name="settings_shell_modal_import_settings_message">选择一个备份文件，文件中列出的设置将替换你的设置。文件中未包含的内容不会改变，账户、服务器、同步状态和文件位置永远不会被导入。</string>
    <string name="settings_shell_modal_import_settings_confirm">选择文件</string>

    <string name="settings_shell_modal_migrate_downloads_title">迁移下载内容？</string>
