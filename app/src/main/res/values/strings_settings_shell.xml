    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">Clear Image Cache?</string>
    <string name="settings_shell_caches_image_message">This will delete all cached covers, backgrounds, and screenshots. Images re-download from the server as you browse.</string>
    <string name="settings_shell_caches_rom_extraction_title">Clear Extracted ROMs?</string>
    <string name="settings_shell_caches_rom_extraction_message">This will delete extracted working copies of compressed games. They re-extract the next time each game launches.</string>
    <string name="settings_shell_caches_rom_staging_title">Clear Abandoned Staging?</string>
    <string name="settings_shell_caches_rom_staging_message">This will delete internal working files left behind by downloads that never finished. Downloads still in the queue keep theirs and continue where they left off.</string>
    <string name="settings_shell_caches_sfx_title">Clear Sound Effects Cache?</string>
    <string name="settings_shell_caches_sfx_message">This will delete transcoded custom sound files. They rebuild automatically the next time sounds load.</string>
    <string name="settings_shell_caches_emulator_apks_title">Clear Emulator Installers?</string>
    <string name="settings_shell_caches_emulator_apks_message">This will delete downloaded emulator installer APKs. Installed emulators are not affected.</string>
    <string name="settings_shell_caches_misc_downloads_title">Clear Misc Downloads?</string>
    <string name="settings_shell_caches_misc_downloads_message">This will delete friend presence covers and downloaded GPU driver packages. Installed drivers are not affected.</string>
    <string name="settings_shell_caches_shaders_catalog_title">Clear Shader Catalog?</string>
    <string name="settings_shell_caches_shaders_catalog_message">This will delete downloaded catalog shaders. Custom shaders are kept, and catalog shaders re-download on demand.</string>
    <string name="settings_shell_caches_frames_title">Clear Frame Overlays?</string>
    <string name="settings_shell_caches_frames_message">This will delete downloaded frame overlays. They re-download on demand when selected.</string>
    <string name="settings_shell_caches_steam_downloads_title">Clear Steam Download Data?</string>
    <string name="settings_shell_caches_steam_downloads_message">This will delete staged Steam downloads and clear the download queue. Installed games are not affected, but partial downloads restart from zero.</string>

