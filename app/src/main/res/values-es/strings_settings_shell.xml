    <string name="settings_shell_modal_jellyfin_signout_title">¿Cerrar sesión en Jellyfin?</string>
    <string name="settings_shell_modal_jellyfin_signout_message">Este dispositivo olvida tu inicio de sesión de Jellyfin. El contenido multimedia descargado permanece en el disco y tu historial de visualización permanece en el servidor.</string>
    <string name="settings_shell_modal_jellyfin_signout_confirm">Cerrar sesión</string>

    <string name="settings_shell_modal_import_settings_title">¿Importar ajustes?</string>
    <string name="settings_shell_modal_import_settings_message">Elige un archivo de copia de seguridad y los ajustes que contiene reemplazarán los tuyos. Todo lo que el archivo no incluya permanece sin cambios, y las cuentas, servidores, estado de sincronización y ubicaciones de archivos nunca se importan.</string>
    <string name="settings_shell_modal_import_settings_confirm">Elegir archivo</string>

    <string name="settings_shell_modal_migrate_downloads_title">¿Migrar descargas?</string>
    <string name="settings_shell_modal_migrate_downloads_message">¿Mover %1$d juegos (%2$s) a la nueva ubicación?</string>
    <string name="settings_shell_modal_migrate_downloads_confirm">Migrar</string>
    <string name="settings_shell_modal_migrate_downloads_skip">Omitir</string>

    <string name="settings_shell_modal_migrate_platform_title">¿Migrar ROMs de %1$s?</string>
    <string name="settings_shell_modal_migrate_platform_fallback">Plataforma</string>
    <string name="settings_shell_modal_migrate_platform_message">¿Mover los juegos descargados a la nueva ubicación? Los archivos se copiarán y luego se eliminarán de la ubicación anterior.</string>
    <string name="settings_shell_modal_migrate_platform_confirm">Migrar</string>
    <string name="settings_shell_modal_migrate_platform_skip">Omitir</string>

    <string name="settings_shell_modal_purge_platform_title">¿Purgar %1$s?</string>
    <string name="settings_shell_modal_purge_platform_fallback">Plataforma</string>
    <string name="settings_shell_modal_purge_platform_message">Esto eliminará los %1$d juegos y sus archivos ROM locales. Esta acción no se puede deshacer.</string>
    <string name="settings_shell_modal_purge_platform_confirm">Purgar</string>

    <string name="settings_shell_modal_sync_first_title">Sincronizar guardados primero</string>
    <string name="settings_shell_modal_sync_first_message">Sincroniza los guardados primero: %1$d pendientes. Restablecer la biblioteca ahora descartaría permanentemente los guardados que no se han subido.</string>
    <string name="settings_shell_modal_sync_first_confirm">Sincronizar ahora</string>

    <string name="settings_shell_modal_reset_library_title">¿Restablecer biblioteca?</string>
    <string name="settings_shell_modal_reset_library_message">Borra la base de datos y la caché de imágenes. Los archivos descargados permanecen en el disco. Se perderá permanentemente: el tiempo de juego, las colecciones locales, el historial de descargas, el estado de sincronización de guardados y los ajustes por juego. Tendrás que volver a sincronizar tu biblioteca.</string>
    <string name="settings_shell_modal_reset_library_confirm">Restablecer</string>

