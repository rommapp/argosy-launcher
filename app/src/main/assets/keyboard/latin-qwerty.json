{
  "id": "latin-qwerty",
  "version": 1,
  "script": "Latn",
  "locales": ["en", "es", "it", "pt", "nl", "sv", "da", "nb", "fi", "pl", "cs", "tr", "id", "vi"],
  "composer": "none",
  "pages": {
    "letters": {
      "shift": "upper",
      "rows": [
        [{"k": "1", "s": "!"}, {"k": "2", "s": "@"}, {"k": "3", "s": "#"}, {"k": "4", "s": "$"}, {"k": "5", "s": "%"}, {"k": "6", "s": "^"}, {"k": "7", "s": "&"}, {"k": "8", "s": "*"}, {"k": "9", "s": "("}, {"k": "0", "s": ")"}],
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        [{"pad": 0.5}, "a", "s", "d", "f", "g", "h", "j", "k", "l", {"pad": 0.5}],
        [{"fn": "shift", "w": 1.5}, "z", "x", "c", "v", "b", "n", "m", {"fn": "backspace", "w": 1.5}]
      ]
    },
    "symbols": {"ref": "shared-symbols", "asciiOnly": true}
  },
  "accents": {
    "a": ["à", "á", "â", "ä", "æ", "ã", "å", "ā"],
    "e": ["è", "é", "ê", "ë", "ē", "ė", "ę"],
    "c": ["ç", "ć", "č"],
    "n": ["ñ", "ń"],
    "s": ["ß", "ś", "š"],
    "i": ["ì", "í", "î", "ï", "ī", "į", "ı"],
    "o": ["ò", "ó", "ô", "ö", "õ", "ø", "ō", "œ", "ő"],
    "u": ["ù", "ú", "û", "ü", "ū", "ů", "ű"],
    "y": ["ý", "ÿ"],
    "z": ["ž", "ź", "ż"],
    "l": ["ł", "ľ", "ĺ"],
    "g": ["ğ"],
    "d": ["ď", "đ", "ð"],
    "r": ["ř", "ŕ"],
    "t": ["ť", "þ"],
    "$": ["€", "£", "¥", "₹", "₩", "₽"]
  },
  "accentDefault": {
    "fr": {"e": "é"},
    "es": {"n": "ñ"},
    "de": {"s": "ß"}
  }
}
