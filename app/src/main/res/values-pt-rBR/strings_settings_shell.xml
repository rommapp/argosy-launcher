    <string name="settings_shell_modal_reset_save_cache_title">Redefinir o cache de salvamentos?</string>
    <string name="settings_shell_modal_reset_save_cache_message">Isso excluirá todos os instantâneos de salvamento em cache local e as operações de sincronização pendentes. Seus arquivos de salvamento e os salvamentos no servidor não serão afetados.</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">Redefinir</string>
    <string name="settings_shell_modal_remove_frame_title">Remover moldura?</string>
    <string name="settings_shell_modal_remove_frame_message">Esta moldura importada será excluída. As plataformas que a utilizam voltarão ao padrão.</string>
    <string name="settings_shell_modal_remove_frame_confirm">Remover</string>
    <string name="settings_shell_modal_clear_save_path_cache_title">Limpar o cache do caminho de salvamento?</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">Isso limpará todos os caminhos de arquivos de salvamento detectados. Os caminhos serão detectados novamente na próxima sincronização. Utilize esta opção se os salvamentos estiverem sendo sincronizados no local errado.</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">Limpar</string>
    <string name="settings_shell_modal_secure_saves_off_title">Desativar os Salvamentos Seguros?</string>
    <string name="settings_shell_modal_secure_saves_off_message">Isso desativa o modo Hardcore do RetroAchievements. Os jogos iniciarão no modo casual até que os Salvamentos Seguros sejam reativados.</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">Desativar</string>
    <string name="settings_shell_modal_clear_state_cache_title">Limpar o cache de estados?</string>
    <string name="settings_shell_modal_clear_state_cache_message">Isso excluirá todos os instantâneos de estados de salvamento em cache local e suas operações de sincronização pendentes. Os arquivos de salvamento e as cópias no servidor não serão afetados.</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">Limpar</string>
    <string name="settings_shell_modal_caches_clear_confirm">Limpar</string>
    <string name="settings_shell_modal_delete_core_title">Excluir core?</string>
    <string name="settings_shell_modal_delete_core_message">O core será removido deste dispositivo. Os jogos configurados para usá-lo precisarão baixá-lo novamente antes de serem executados.</string>
    <string name="settings_shell_modal_delete_core_confirm">Excluir</string>
    <string name="settings_shell_modal_sync_saves_title">Sincronizar salvamentos?</string>
    <string name="settings_shell_modal_sync_saves_message">Isso irá analisar todos os jogos baixados em busca de alterações nos salvamentos e sincronizá-los com o servidor. Os salvamentos locais mais recentes que a última sincronização serão enviados, e os mais recentes do servidor serão baixados.</string>
    <string name="settings_shell_modal_sync_saves_confirm">Sincronizar</string>
    <string name="settings_shell_accounts_add_title">Adicionar uma conta?</string>
    <string name="settings_shell_accounts_switch_title">Trocar para %1$s?</string>
    <string name="settings_shell_accounts_fallback_name">conta</string>
    <string name="settings_shell_accounts_exit_message">Ferche completamente qualquer jogo iniciado fora do Argosy primeiro. O Argosy não visualiza essas sessões e um jogo ainda em execução pode sobrescrever os salvamentos que estão sendo transferidos. Os salvamentos são arquivados e verificados antes de qualquer coisa ser removida.</string>
