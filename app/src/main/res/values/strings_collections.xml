<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Owner: ui/screens/collections
      Key prefix: collections_
      Keys are named for the usage site, never for the English text, and identical English
      is never shared between two usage sites.
    -->

    <!-- Row on the Browse By list. Opens the genre list. Noun, plural. -->
    <string name="collections_browse_genres">Genres</string>
    <!-- Row on the Browse By list. Opens the list of game modes, meaning single player,
         co-op, multiplayer and so on. Noun, plural. Not "game modifications". -->
    <string name="collections_browse_game_modes">Game Modes</string>
    <!-- Row on the Browse By list. Opens the list of game series, meaning franchises such
         as Mario or Final Fantasy. Noun, plural. -->
    <string name="collections_browse_series">Series</string>

    <!-- Heading above the user's own collections. Rendered in caps in English; use whatever
         casing is normal for a heading in your language. -->
    <string name="collections_section_mine">MY COLLECTIONS</string>
    <!-- Heading above the automatic browse-by rows. Caps as above. "Browse by genre, by
         game mode..." so the phrase is deliberately unfinished. -->
    <string name="collections_section_browse_by">BROWSE BY</string>

    <!-- Spoken by the screen reader for the pin icon on a collection the user pinned.
         Adjective describing the collection, not the verb "to pin". -->
    <string name="collections_pinned_description">Pinned</string>

    <!-- Button that creates a new collection. Verb phrase or noun phrase, whichever reads
         as an action in your language. -->
    <string name="collections_new">New Collection</string>

    <!-- How many games a collection holds. -->
    <plurals name="collections_game_count">
        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>
    <!-- How many categories a browse-by row holds, for example how many distinct genres
         exist across the library. -->
    <plurals name="collections_category_count">
        <item quantity="one">%d category</item>
        <item quantity="other">%d categories</item>
    </plurals>

    <!-- === CollectionOptionsModal.kt === -->
    <!-- Option row. Downloads every game in the collection that is not already local; %1$d is
         how many games qualify. -->
    <string name="collections_options_download_all">Download All (%1$d)</string>
    <!-- Option row. Verb phrase: open the rename dialog for this collection. -->
    <string name="collections_options_rename">Rename Collection</string>
    <!-- Option row. Verb phrase: delete this collection (not its games). -->
    <string name="collections_options_delete">Delete Collection</string>
    <!-- Option row. Verb phrase: remove one game from the collection; %1$s is the game's title. -->
    <string name="collections_options_remove_game">Remove \"%1$s\"</string>
    <!-- Fallback noun used in place of the game's title above if it is somehow unknown. -->
    <string name="collections_options_remove_game_fallback">Game</string>

    <!-- === DeleteCollectionDialog.kt === -->
    <string name="collections_delete_dialog_title">Delete Collection</string>
    <!-- %1$s is the collection's name. -->
    <string name="collections_delete_dialog_message">Are you sure you want to delete \"%1$s\"? This will remove the collection but not the games in it.</string>
    <!-- Button. Verb: confirms the collection deletion. -->
    <string name="collections_delete_dialog_confirm">Delete</string>

    <!-- === CreateCollectionDialog.kt === -->
    <string name="collections_create_dialog_title">Create Collection</string>
    <!-- Text field label for the new collection's name. "Collection" here is the user's custom
         game grouping feature, not any other in-app sense of the word. -->
    <string name="collections_create_dialog_name_label">Collection name</string>
    <!-- Button. Verb: creates the new collection. -->
    <string name="collections_create_dialog_confirm">Create</string>

    <!-- === EditCollectionDialog.kt === -->
    <string name="collections_edit_dialog_title">Edit Collection</string>
    <!-- Text field label for the collection's name, being renamed. Same disambiguation as
         collections_create_dialog_name_label; kept as a separate key per usage site. -->
    <string name="collections_edit_dialog_name_label">Collection name</string>
    <!-- Button. Verb: commits the renamed collection. Not the noun "save" used for game saves
         elsewhere in this app. -->
    <string name="collections_edit_dialog_confirm">Save</string>

    <!-- === RemoveGameDialog.kt === -->
    <string name="collections_removegame_dialog_title">Remove Game</string>
    <!-- %1$s is the game's title, %2$s is the collection's name. -->
    <string name="collections_removegame_dialog_message">Remove \"%1$s\" from \"%2$s\"?</string>
    <!-- Button. Verb: confirms removing the game from the collection. -->
    <string name="collections_removegame_dialog_confirm">Remove</string>

    <!-- === CollectionNameDialog.kt === -->
    <!-- Button. Verb: dismiss the create/edit-collection dialog without saving. -->
    <string name="collections_namedialog_cancel">Cancel</string>

    <!-- === CollectionsScreen.kt: footer hints === -->
    <string name="collections_screen_hint_navigate">Navigate</string>
    <string name="collections_screen_hint_select">Select</string>
    <string name="collections_screen_hint_back">Back</string>
    <!-- Verb, in progress: a manual refresh is running. -->
    <string name="collections_screen_hint_refreshing">Refreshing&#8230;</string>
    <!-- Verb: trigger a manual refresh. -->
    <string name="collections_screen_hint_refresh">Refresh</string>
    <string name="collections_screen_hint_unpin">Unpin</string>
    <string name="collections_screen_hint_pin">Pin</string>
    <string name="collections_screen_hint_options">Options</string>

    <!-- === CollectionDetailScreen.kt === -->
    <string name="collections_detail_loading">Loading&#8230;</string>
    <!-- Footer hint, search active. Verb: open the focused game. -->
    <string name="collections_detail_hint_search_open">Open</string>
    <string name="collections_detail_hint_search_close">Close Search</string>
    <string name="collections_detail_hint_navigate">Navigate</string>
    <!-- Footer hint, search inactive. Verb: open the focused game. Distinct key from
