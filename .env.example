# Argosy environment configuration
# Copy this file to .env and fill in your values.

# RomM server: your instance URL and a long-lived client API token
# (create one in RomM: Settings > Client Tokens; POST /api/client-tokens).
ROMM_BASE_URL=https://romm.example.com
ROMM_CLIENT_TOKEN_FILE=~/.romm-client-token

# Optional: override default ROM storage path
# ROM_STORAGE_PATH=/storage/emulated/0/ROMs

# Optional: enable debug logging
# DEBUG=true
