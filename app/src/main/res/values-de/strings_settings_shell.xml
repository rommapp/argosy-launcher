    <string name="settings_shell_accounts_switch_confirm">Spiele geschlossen, wechseln</string>

    <string name="settings_shell_accounts_remove_title">%1$s entfernen?</string>
    <string name="settings_shell_accounts_remove_fallback_name">Konto</string>
    <string name="settings_shell_accounts_removal_message_base">Entfernt die Spielstände, Savestates, wartenden Aufgaben, Erfolge und die Bibliotheks-Überlagerung dieses Kontos von diesem Gerät. Heruntergeladene Spiele bleiben erhalten.</string>
    <string name="settings_shell_accounts_removal_pending_suffix"> Noch nicht gesendet: %1$s.</string>
    <string name="settings_shell_accounts_removal_last_account_suffix"> Dies ist das letzte Konto, daher wird das Gerät von RomM abgemeldet.</string>
