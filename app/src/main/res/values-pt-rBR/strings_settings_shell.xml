    <string name="settings_shell_accounts_remove_title">Remover %1$s?</string>
    <string name="settings_shell_accounts_remove_fallback_name">conta</string>
    <string name="settings_shell_accounts_removal_message_base">Remove os salvamentos, estados, trabalhos na fila, conquistas e a visualização da biblioteca dessa conta deste dispositivo. Os jogos baixados são mantidos.</string>
    <string name="settings_shell_accounts_removal_pending_suffix">Ainda não enviados: %1$s.</string>
    <string name="settings_shell_accounts_removal_last_account_suffix">Esta é a última conta, portanto o dispositivo será desconectado do RomM.</string>
    <string name="settings_shell_accounts_removal_revoke_suffix">O dispositivo permanece registrado no servidor do RomM; revogue o acesso lá.</string>
