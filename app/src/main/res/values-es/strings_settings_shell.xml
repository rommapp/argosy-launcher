    <string name="settings_shell_romm_signout_message">Las partidas guardadas, estados y ajustes en caché de esta cuenta se eliminan de este dispositivo, y todo lo que ya se subió permanece en tu servidor. Tus juegos descargados permanecen.</string>
    <string name="settings_shell_modal_romm_signout_confirm">Cerrar sesión</string>

    <string name="settings_shell_modal_reset_save_cache_title">¿Restablecer caché de guardados?</string>
    <string name="settings_shell_modal_reset_save_cache_message">Esto eliminará todas las instantáneas de guardado en caché local y las operaciones de sincronización pendientes. Tus archivos de guardado reales y los guardados del servidor no se ven afectados.</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">Restablecer</string>

    <string name="settings_shell_modal_clear_save_path_cache_title">¿Vaciar caché de rutas de guardado?</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">Esto borrará todas las rutas de archivos de guardado detectadas. Las rutas se volverán a detectar en la próxima sincronización. Usa esto si los guardados se sincronizan en el lugar equivocado.</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">Vaciar</string>

    <string name="settings_shell_modal_secure_saves_off_title">¿Desactivar Guardados seguros?</string>
    <string name="settings_shell_modal_secure_saves_off_message">Desactivar esto deshabilita el modo hardcore de RetroAchievements. Los juegos se lanzarán en modo casual hasta que vuelvas a activar Guardados seguros.</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">Desactivar</string>

    <string name="settings_shell_modal_clear_state_cache_title">¿Vaciar caché de estados?</string>
    <string name="settings_shell_modal_clear_state_cache_message">Esto eliminará todas las instantáneas de estado en caché local y sus operaciones de sincronización pendientes. Los archivos de guardado y las copias del servidor no se ven afectados.</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">Vaciar</string>

    <string name="settings_shell_modal_caches_clear_confirm">Vaciar</string>

    <string name="settings_shell_modal_delete_core_title">¿Eliminar core?</string>
    <string name="settings_shell_modal_delete_core_message">El core se elimina de este dispositivo. Los juegos configurados para usarlo necesitarán volver a descargarlo antes de poder ejecutarse.</string>
    <string name="settings_shell_modal_delete_core_confirm">Eliminar</string>

    <string name="settings_shell_modal_sync_saves_title">¿Sincronizar guardados?</string>
    <string name="settings_shell_modal_sync_saves_message">Esto escaneará todos los juegos descargados en busca de cambios en los guardados y los sincronizará con el servidor. Los guardados locales más recientes que la última sincronización se subirán, y los guardados del servidor más recientes se descargarán.</string>
    <string name="settings_shell_modal_sync_saves_confirm">Sincronizar</string>

