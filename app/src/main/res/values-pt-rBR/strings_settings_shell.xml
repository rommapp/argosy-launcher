    <string name="settings_shell_caches_image_title">Limpar cache de imagens?</string>
    <string name="settings_shell_caches_image_message">Isso excluirá todas as capas, planos de fundo e capturas de tela em cache. As imagens serão baixadas do servidor novamente conforme você navega.</string>
    <string name="settings_shell_caches_rom_extraction_title">Limpar ROMs extraídas?</string>
    <string name="settings_shell_caches_rom_extraction_message">Isso excluirá cópias de trabalho extraídas de jogos compactados. Elas serão extraídas novamente na próxima vez que cada jogo for iniciado.</string>
    <string name="settings_shell_caches_rom_staging_title">Limpar staging abandonado?</string>
    <string name="settings_shell_caches_rom_staging_message">Isso excluirá arquivos internos de trabalho deixados por downloads que nunca foram concluídos. Os downloads ainda na fila mantêm os seus e continuam de onde pararam.</string>
    <string name="settings_shell_caches_sfx_title">Limpar cache de efeitos sonoros?</string>
    <string name="settings_shell_caches_sfx_message">Isso excluirá os arquivos de som personalizados transcodificados. Eles serão regenerados automaticamente na próxima vez que os sons forem carregados.</string>
    <string name="settings_shell_caches_emulator_apks_title">Limpar instaladores de emulador?</string>
    <string name="settings_shell_caches_emulator_apks_message">Isso excluirá os APKs de instalador de emulador baixados. Os emuladores instalados não serão afetados.</string>
    <string name="settings_shell_caches_misc_downloads_title">Limpar downloads diversos?</string>
    <string name="settings_shell_caches_misc_downloads_message">Isso excluirá as capas de presença de amigos e os pacotes de drivers de GPU baixados. Os drivers instalados não serão afetados.</string>
    <string name="settings_shell_caches_shaders_catalog_title">Limpar catálogo de shaders?</string>
    <string name="settings_shell_caches_shaders_catalog_message">Isso excluirá os shaders de catálogo baixados. Os shaders personalizados serão mantidos, e os shaders do catálogo serão baixados sob demanda.</string>
    <string name="settings_shell_caches_frames_title">Limpar sobreposições de quadros?</string>
    <string name="settings_shell_caches_frames_message">Isso excluirá as sobreposições de quadros baixadas. Elas serão baixadas sob demanda quando selecionadas.</string>
