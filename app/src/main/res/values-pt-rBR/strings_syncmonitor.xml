<?xml version="1.0" encoding="utf-8"?>
<!--
  Library sync monitor. Owner: ui/screens/syncmonitor.
  One row per platform: what the library holds for it, and what a running sync is doing to it.
-->
<resources>
    <!-- Screen title. Noun phrase. -->
    <string name="syncmonitor_title">Sincronização da Biblioteca</string>
    <!-- Drawer entry for the screen. Noun phrase, same subject as the title. -->
    <string name="syncmonitor_drawer_title">Sincronização da Biblioteca</string>

    <!-- Header after a sync starts, before the server has named the platforms. -->
    <string name="syncmonitor_progress_starting">Iniciando</string>
    <!-- Header when a sync has never run. -->
    <string name="syncmonitor_never_synced">Nunca sincronizado</string>
    <!-- Header giving the age of the last successful sync. -->
    <string name="syncmonitor_last_synced">Última sincronização %1$s</string>
    <!-- Header when the last sync left one or more platforms failed. -->
    <string name="syncmonitor_finished_with_failures">%1$d plataformas falharam</string>
    <!-- Header when there is no server to sync with. The counts below it are still local truth. -->
    <string name="syncmonitor_not_connected">Não conectado ao RomM</string>
    <!-- Header line under the subtitle: what the whole library holds. -->
    <string name="syncmonitor_library_summary">%1$d plataformas · %2$d jogos · %3$d no dispositivo</string>

    <!-- Heading above the platforms excluded from sync. Adjective. -->
    <string name="syncmonitor_group_disabled">Desativadas</string>

    <!-- Row line for an idle platform: what the library holds for it. -->
    <string name="syncmonitor_row_summary">%1$d jogos · %2$d no dispositivo · %3$d com saves</string>
    <!-- Row line for a platform excluded from sync. Its games are still on disk. -->
    <string name="syncmonitor_row_excluded">Excluída · %1$d jogos · %2$d no dispositivo</string>

    <!-- Row status: waiting its turn. Adjective. -->
    <string name="syncmonitor_state_queued">Na fila</string>
    <!-- Row status while running: games processed of the total this platform reports. -->
    <string name="syncmonitor_state_syncing">%1$d / %2$d</string>
    <!-- Row status when a platform failed and the server gave no reason. -->
    <string name="syncmonitor_state_failed">Falhou</string>

    <!-- Row action: sync this platform alone. Verb. -->
    <string name="syncmonitor_action_sync">Sincronizar</string>
    <!-- Row action on an excluded platform: include it in future syncs and sync it now.
         Two verbs sharing one object. -->
    <string name="syncmonitor_action_enable">Ativar &amp; Sincronizar</string>

    <!-- Badge on a finished row: how many games this platform gained. -->
    <string name="syncmonitor_badge_added">%1$d novos</string>
    <!-- Badge on a finished row: how many existing games changed. -->
    <string name="syncmonitor_badge_updated">%1$d atualizados</string>
    <!-- Badge on a finished row: how many games left the library. -->
    <string name="syncmonitor_badge_removed">%1$d removidos</string>

    <!-- Shown instead of rows when connected with no platforms yet. -->
    <string name="syncmonitor_empty_idle">Sincronize para baixar sua biblioteca do RomM</string>
    <!-- Shown instead of rows when there is no server and nothing local. -->
    <string name="syncmonitor_empty_disconnected">Conecte-se ao RomM para sincronizar sua biblioteca</string>

    <!-- Footer hint: syncs every enabled platform. Verb. -->
    <string name="syncmonitor_footer_sync_all">Sincronizar tudo</string>
    <!-- Footer hint: leaves the screen. Verb. -->
    <string name="syncmonitor_footer_back">Voltar</string>
</resources>