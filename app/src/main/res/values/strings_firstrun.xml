<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Owner: ui/screens/setup (the library, save sync and platforms pages)
      Key prefix: firstrun_
      Keys are named for the usage site, never for the English text, and identical English
      is never shared between two usage sites.

      These label parts of the setup flow a new user sees before anything else in the app.
      Newer setup strings live in strings_setup.xml under the setup_ prefix.

      Product names that are NEVER translated, wherever they appear in this file:
      Argosy (this app), RomM (the game library server this app connects to).
    -->

    <!-- ===== Welcome ===== -->

    <!-- Product wordmark on the welcome page. A brand name, never translated. -->
    <string name="firstrun_welcome_wordmark" translatable="false">ARGOSY</string>

    <!-- ===== Server address ===== -->

    <!-- Enter key of the on-screen controller keyboard while typing the server address. Verb,
         imperative: submit the address. -->
    <string name="firstrun_romm_url_keyboard_submit">Continue</string>
    <!-- Label the continue button takes on while the app is contacting the server to see which
         sign-in methods it offers. Present-progressive verb. -->
    <string name="firstrun_romm_url_button_checking">Checking...</string>
    <!-- Button that opens a file browser to pick a certificate file for a server whose issuer
         this device does not recognise. Verb, imperative. -->
    <string name="firstrun_romm_certificate_button">Add Certificate</string>
    <!-- The same button once certificates have been added. %1$d is how many. -->
    <string name="firstrun_romm_certificate_button_count">Certificates (%1$d)</string>
    <!-- Error shown when the chosen file could not be read as a certificate. -->
    <string name="firstrun_romm_certificate_import_failed">That file is not a readable certificate.</string>
    <!-- Error shown when the server answered but this device does not recognise the authority
         that issued its certificate. Names the remedy, which is the Add Certificate button. -->
    <string name="firstrun_romm_error_untrusted_certificate">This device does not trust the server\'s certificate. Add the certificate to connect.</string>

    <!-- ===== Signing in with a pairing code typed by hand ===== -->

    <!-- Heading of the view where the user types the pairing code. A pairing code is a short
         one-off code that links this device to the user's server account. Imperative. -->
    <string name="firstrun_pairing_code_title">Enter pairing code</string>
    <!-- Instructions above the code field. An "API token" is created by the user in the RomM
         web interface and becomes the pairing code. The code is always 8 characters, which is
         fixed by the server protocol, so the number stays 8 in every language. -->
    <string name="firstrun_pairing_code_hint">Create an API token in the RomM web UI, then enter the 8-character code.</string>
    <!-- Button that sends the typed pairing code to the server. Verb, imperative. -->
    <string name="firstrun_pairing_code_button_connect">Connect</string>
    <!-- Enter key of the on-screen controller keyboard while typing the pairing code. Verb,
         imperative: send the code to the server. -->
    <string name="firstrun_pairing_code_keyboard_submit">Connect</string>
    <!-- Label the same button takes on while the code is being checked. Present-progressive. -->
    <string name="firstrun_pairing_code_button_connecting">Connecting...</string>
    <!-- Error shown when the user submits a pairing code shorter than the full 8 characters.
         Imperative sentence. The length is fixed by the server protocol. -->
    <string name="firstrun_pairing_code_error_incomplete">Enter the full 8-character pairing code</string>

    <!-- ===== Signing in by approving this device elsewhere ===== -->

    <!-- Button that abandons QR approval and switches to typing a pairing code by hand.
         Verb phrase, imperative. -->
    <string name="firstrun_device_pairing_button_manual_code">Use a pairing code</string>
    <!-- Error shown when the user rejected this device instead of approving it. Past tense
         statement of what happened, not an instruction. -->
    <string name="firstrun_device_pairing_error_denied">Pairing was denied on the server</string>
    <!-- Error shown when the pairing code timed out before anyone approved it. Statement plus
         an imperative telling the user to restart the pairing. -->
    <string name="firstrun_device_pairing_error_expired">Pairing code expired, start again</string>
    <!-- Error shown when the server answers pairing with something the app does not recognise.
         Statement, deliberately vague because the cause is unknown. -->
    <string name="firstrun_device_pairing_error_unexpected">Unexpected pairing result</string>

    <!-- ===== Signed in ===== -->

    <!-- Summary of the library found on the server, assembled from the two counts below so
         that each count can take its own plural form. %1$s is the game count phrase and
         %2$s is the platform count phrase; reorder them as your language needs. -->
    <string name="firstrun_romm_success_library">%1$s across %2$s</string>
    <!-- How many games the server holds, used only inside firstrun_romm_success_library.
         "Game" here means one title in the library. -->
    <plurals name="firstrun_romm_success_game_count">
        <item quantity="one">%,d game</item>
        <item quantity="other">%,d games</item>
    </plurals>
    <!-- How many platforms the server holds, used only inside firstrun_romm_success_library.
         A "platform" is a games console or computer system, for example a handheld console,
         not a software platform. -->
    <plurals name="firstrun_romm_success_platform_count">
        <item quantity="one">%d platform</item>
        <item quantity="other">%d platforms</item>
    </plurals>
    <!-- Error shown when sign-in worked but reading the library listing afterwards failed.
         %1$s is a message from the server and arrives untranslated. -->
    <string name="firstrun_romm_success_error_library_fetch">Failed to fetch library: %1$s</string>

    <!-- ===== Save sync: whether saves are backed up to the server ===== -->

    <!-- Heading of the page that asks whether game saves sync with the server. "Save" is a noun
         here: a game's save data. -->
    <string name="firstrun_save_sync_title">Save sync</string>
    <!-- Option that turns save sync on. "Sync" is a verb; "saves" is a noun (game save data). -->
    <string name="firstrun_save_sync_option_on_title">Sync saves</string>
    <!-- Description under that option. "states" are save states, snapshots of a running game. -->
    <string name="firstrun_save_sync_option_on_description">Backs up saves and states, and restores them before you play</string>
    <!-- Option that leaves save sync off. "saves" is a noun (game save data). -->
    <string name="firstrun_save_sync_option_off_title">Keep saves on this device</string>
    <!-- Description under that option. "Settings" names this app's own Settings screen. -->
    <string name="firstrun_save_sync_option_off_description">Nothing is uploaded. You can turn sync on later in Settings.</string>
    <!-- Accessibility label of the check mark on a chosen setup option. Adjective. -->
    <string name="firstrun_save_sync_option_selected">Selected</string>

    <!-- ===== Choosing which platforms to sync ===== -->

    <!-- Second line of each platform row, counting the games the server holds for that one
         platform. -->
    <plurals name="firstrun_platform_select_game_count">
        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>
    <!-- Button that switches every platform in the list on. Verb phrase, imperative. -->
    <string name="firstrun_platform_select_button_select_all">Select All</string>
    <!-- Label the same button takes on once every platform is already on, which switches them
         all off. Verb phrase, imperative. -->
    <string name="firstrun_platform_select_button_deselect_all">Deselect All</string>
    <string name="firstrun_romm_error_sign_in_interrupted">Unable to complete sign-in. Please try again.</string>
</resources>
