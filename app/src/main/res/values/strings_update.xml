<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Settings > About, update row ===== -->
    <!-- Button that deletes the stored copy of the new version and fetches it again. Verb phrase. -->
    <string name="settings_about_update_action_redownload">Download Again</string>
    <!-- Second line of the update row when the user chose to skip this version. %1$s is its version number. -->
    <string name="settings_about_update_subtitle_skipped">%1$s (Skipped)</string>
    <!-- Second line of the update row when the new version is already on the device. %1$s is its version number. -->
    <string name="settings_about_update_subtitle_stored">%1$s is downloaded and ready to install</string>

    <!-- ===== Settings > About, debug section ===== -->
    <!-- Row title, shown only in development builds. Noun phrase: whether this build looks for new versions. -->
    <string name="settings_about_debug_update_checks_title">Update Checks</string>
    <!-- Second line of that row while it is on. -->
    <string name="settings_about_debug_update_checks_subtitle_on">This debug build checks for updates and shows the update prompt</string>
    <!-- Second line of that row while it is off. -->
    <string name="settings_about_debug_update_checks_subtitle_off">Debug builds do not check for updates</string>

    <!-- ===== Update prompt (shown over the launcher when a new version is found) ===== -->
    <!-- Prompt heading. "Argosy" is this app's name. %1$s is the new version number, such as 3.1.0. -->
    <string name="update_prompt_title">Argosy %1$s is available</string>
    <!-- Prompt button that installs the new version, fetching it first if needed. Verb. -->
    <string name="update_prompt_action_install">Install</string>
    <!-- Prompt button that stops offering this one version. Verb phrase. -->
    <string name="update_prompt_action_skip">Skip This Version</string>
    <!-- Prompt button that closes the prompt until the app is next started. Adverb used as a button. -->
    <string name="update_prompt_action_later">Later</string>
    <!-- Status line while the new version downloads. %1$d is a percentage. -->
    <string name="update_prompt_downloading">Downloading... %1$d%%</string>
    <!-- Status line when the download stopped before it finished. -->
    <string name="update_prompt_download_failed">The download did not finish. Choose Install to try again.</string>
    <!-- Shown in the notes panel when the release has no notes. -->
    <string name="update_prompt_notes_empty">This release has no notes.</string>
    <!-- Footer hint for the stick that scrolls the release notes. Verb. -->
    <string name="update_prompt_hint_scroll">Scroll</string>
</resources>
