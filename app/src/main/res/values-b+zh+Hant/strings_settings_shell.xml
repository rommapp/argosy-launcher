    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">要清除圖片快取嗎？</string>
    <string name="settings_shell_caches_image_message">這會刪除所有快取的封面、背景與螢幕截圖，瀏覽時圖片會從伺服器重新下載。</string>
    <string name="settings_shell_caches_rom_extraction_title">要清除已解壓縮的ROM嗎？</string>
    <string name="settings_shell_caches_rom_extraction_message">這會刪除壓縮遊戲解壓縮出的工作副本，下次啟動遊戲時會重新解壓縮。</string>
    <string name="settings_shell_caches_rom_staging_title">要清除已捨棄的暫存嗎？</string>
    <string name="settings_shell_caches_rom_staging_message">這會刪除未完成下載所留下的內部工作檔案。仍在佇列中的下載會保留其檔案，並從中斷處繼續。</string>
    <string name="settings_shell_caches_sfx_title">要清除音效快取嗎？</string>
    <string name="settings_shell_caches_sfx_message">這會刪除已轉碼的自訂音效檔案，下次載入音效時會自動重建。</string>
    <string name="settings_shell_caches_emulator_apks_title">要清除模擬器安裝檔嗎？</string>
    <string name="settings_shell_caches_emulator_apks_message">這會刪除已下載的模擬器安裝用APK，不會影響已安裝的模擬器。</string>
    <string name="settings_shell_caches_misc_downloads_title">要清除其他下載內容嗎？</string>
    <string name="settings_shell_caches_misc_downloads_message">這會刪除好友狀態封面與已下載的GPU驅動程式套件，不會影響已安裝的驅動程式。</string>
    <string name="settings_shell_caches_shaders_catalog_title">要清除著色器目錄嗎？</string>
    <string name="settings_shell_caches_shaders_catalog_message">這會刪除已下載的目錄著色器，自訂著色器會保留，目錄著色器會在需要時重新下載。</string>
    <string name="settings_shell_caches_frames_title">要清除邊框疊層嗎？</string>
    <string name="settings_shell_caches_frames_message">這會刪除已下載的邊框疊層，選取時會重新下載。</string>
    <string name="settings_shell_caches_steam_downloads_title">要清除Steam下載資料嗎？</string>
    <string name="settings_shell_caches_steam_downloads_message">這會刪除暫存的Steam下載內容並清空下載佇列，不會影響已安裝的遊戲，但未完成的下載會從頭開始。</string>

