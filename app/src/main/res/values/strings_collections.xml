    <string name="collections_category_hint_download_all">Download All (%1$d)</string>
    <string name="collections_category_downloadall_title">Queuing Downloads</string>
    <!-- Download-all progress. %1$d is the number of games queued so far, %2$d is the total. -->
    <plurals name="collections_category_downloadall_progress">
        <item quantity="one">%1$d of %2$d game</item>
        <item quantity="other">%1$d of %2$d games</item>
    </plurals>
    <string name="collections_category_back_description">Back</string>
    <!-- Search field placeholder; %1$s is the category's own name (for example "Platformer"). -->
    <string name="collections_category_search_placeholder">Search %1$s</string>
    <string name="collections_category_close_search_description">Close search</string>
    <string name="collections_category_search_description">Search</string>
    <string name="collections_category_empty_title">No games in this category</string>
    <!-- How many games are in this category, shown under its name in the header. -->
    <plurals name="collections_category_header_game_count">
        <item quantity="one">%d game</item>
        <item quantity="other">%d games</item>
    </plurals>
    <!-- Fallback platform name shown on a game card when the game's platform cannot be
         resolved. Distinct key from collections_category_platform_unknown (different
         usage site). -->
    <string name="collections_detail_platform_unknown">Unknown</string>
    <!-- Fallback platform name shown on a game card when the game's platform cannot be
         resolved. Distinct key from collections_detail_platform_unknown. -->
    <string name="collections_category_platform_unknown">Unknown</string>

    <!-- === components/WideGameCard.kt === -->
    <!-- User's own rating out of ten, shown next to a star icon. %1$d is the rating. -->
    <string name="collections_widecard_rating_value">%1$d/10</string>
    <!-- User's own difficulty rating out of ten, shown next to a flame icon. %1$d is the rating. -->
    <string name="collections_widecard_difficulty_value">%1$d/10</string>

    <!-- === downloads/DownloadsScreen.kt === -->
    <string name="downloads_empty_title">No Downloads</string>
    <string name="downloads_empty_subtitle">Downloads will appear here</string>
    <!-- Section header while a finished download is being relocated onto ROM storage. -->
    <string name="downloads_section_header_moving">Moving to ROM Storage</string>
    <!-- Section header while a finished download is being unpacked. Distinct key from
         downloads_file_state_extracting and downloads_item_status_extracting_fallback (different
         usage sites). -->
    <string name="downloads_section_header_extracting">Extracting</string>
    <string name="downloads_section_header_downloading">Downloading</string>
    <!-- Section header for active downloads with no measurable speed yet. -->
    <string name="downloads_section_header_active">Active</string>
    <!-- Section header for downloads waiting their turn. Distinct key from
         downloads_file_state_queued and downloads_item_status_queued_fallback. -->
    <string name="downloads_section_header_queued">Queued</string>
    <string name="downloads_section_header_finished">Finished</string>
    <string name="downloads_hint_navigate">Navigate</string>
    <!-- Footer hint. Verb: permanently remove a finished download entry from the list. -->
    <string name="downloads_hint_remove">Remove</string>
    <!-- Footer hint. Verb: cancel an in-progress or queued download. -->
    <string name="downloads_hint_cancel">Cancel</string>
    <!-- Footer hint. Verb: clear every finished download from the list. -->
    <string name="downloads_hint_clear_finished">Clear Finished</string>
    <string name="downloads_hint_back">Back</string>
    <string name="downloads_failed_dialog_title">Download Failed</string>
    <!-- %1$s is the download's display title. -->
    <string name="downloads_failed_dialog_message">\"%1$s\" failed to download. What would you like to do?</string>
    <!-- Button. Verb: retry the failed download. -->
    <string name="downloads_failed_dialog_confirm">Retry</string>
    <!-- Button. Verb: dismiss and clear the failed download entry. -->
    <string name="downloads_failed_dialog_clear">Clear</string>
    <!-- Per-file state, inside a multi-file group. Adjective: this file finished. -->
    <string name="downloads_file_state_done">Done</string>
    <string name="downloads_file_state_extracting">Extracting</string>
    <string name="downloads_file_state_moving">Moving</string>
    <string name="downloads_file_state_failed">Failed</string>
    <string name="downloads_file_state_queued">Queued</string>
    <!-- Per-file download percentage. %1$d is 0-100. -->
    <string name="downloads_file_state_percent">%1$d%%</string>
    <string name="downloads_file_state_waiting_for_server">Waiting for server&#8230;</string>
    <string name="downloads_item_status_moving">Moving to ROM storage&#8230;</string>
    <!-- Fallback shown while extracting if no core-reported status message is available. -->
    <string name="downloads_item_status_extracting_fallback">Extracting&#8230;</string>
    <!-- Shown on an active transfer until the server sends its first byte. -->
    <string name="downloads_item_status_waiting_for_server">Waiting for server&#8230;</string>
    <!-- %1$s and %2$s are already-formatted byte amounts, for example "1.2 GB". -->
    <string name="downloads_item_status_insufficient_storage">Need %1$s, Available %2$s</string>
    <!-- Fallback shown for a failed active download with no specific error reason. -->
    <string name="downloads_item_status_failed_fallback">Download failed</string>
    <!-- Fallback shown for a queued download with no core-reported status message. -->
    <string name="downloads_item_status_queued_fallback">Queued</string>
    <!-- Fallback shown for a failed completed-list download with no specific error reason.
         Distinct key from downloads_item_status_failed_fallback (different usage site). -->
    <string name="downloads_completed_status_failed_fallback">Download failed</string>
    <!-- Adjective: the download finished and installed successfully. -->
    <string name="downloads_completed_status_installed">Installed</string>
    <!-- Transfer speed suffix; %1$s is an already-formatted byte rate, for example "2.4 MB". -->
    <string name="downloads_speed_suffix">%1$s/s</string>

    <!-- === downloads/DownloadsViewModel.kt: confirm/toggle action labels === -->
    <!-- Button. Verb: pause an active download. -->
    <string name="downloads_action_pause">Pause</string>
    <!-- Button. Verb: resume a paused or failed download. -->
    <string name="downloads_action_resume">Resume</string>
    <!-- Generic fallback action label; should not normally be visible. -->
    <string name="downloads_action_toggle">Toggle</string>
    <!-- Button. Noun: open the failed-download options dialog. -->
    <string name="downloads_action_options">Options</string>
    <!-- Button. Verb: open the completed download's game. -->
    <string name="downloads_action_view">View</string>

    <!-- === downloads/DownloadsViewModel.kt: Steam status messages === -->
    <string name="downloads_steam_status_preparing">Preparing&#8230;</string>
    <string name="downloads_steam_status_connecting">Connecting to Steam&#8230;</string>
    <string name="downloads_steam_status_fetching_manifest">Fetching depot manifest&#8230;</string>
    <!-- Fallback shown while Steam validates local files, if no more specific detail is
         available. -->
    <string name="downloads_steam_status_validating_fallback">Validating&#8230;</string>
    <string name="downloads_steam_status_moving">Moving files&#8230;</string>
    <string name="downloads_steam_status_cleaning">Cleaning up&#8230;</string>
    <!-- Depot progress for a multi-depot Steam download, appended after the byte progress
         text; %1$d is the current depot, %2$d is the total. Leading space is intentional,
         matching how it is concatenated at the call site. -->
    <string name="downloads_steam_status_depot_progress">" (%1$d/%2$d depots)"</string>

    <!-- === downloads/DownloadsViewModel.kt: DownloadGroup.aggregate() === -->
    <!-- Status message for a multi-file download group; %1$d is files completed so far,
         %2$d is the total file count. -->
    <plurals name="downloads_group_progress">
        <item quantity="one">%1$d of %2$d file</item>
        <item quantity="other">%1$d of %2$d files</item>
    </plurals>

    <!-- === touchlayout/TouchLayoutEditorModal.kt === -->
    <string name="touchlayout_editor_title">Customize touch controls</string>
    <string name="touchlayout_editor_orientation_portrait">Portrait</string>
    <string name="touchlayout_editor_orientation_landscape">Landscape</string>
    <!-- Button. Verb: close the touch layout editor. -->
    <string name="touchlayout_editor_close">Close</string>
