    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">Очистить кэш изображений?</string>
    <string name="settings_shell_caches_image_message">Это удалит все кэшированные обложки, фоны и скриншоты. Изображения будут скачаны заново с сервера по мере просмотра.</string>
    <string name="settings_shell_caches_rom_extraction_title">Очистить извлечённые ROM?</string>
    <string name="settings_shell_caches_rom_extraction_message">Это удалит извлечённые рабочие копии сжатых игр. Они будут извлечены заново при следующем запуске каждой игры.</string>
    <string name="settings_shell_caches_rom_staging_title">Очистить брошенные временные файлы?</string>
    <string name="settings_shell_caches_rom_staging_message">Это удалит внутренние рабочие файлы, оставшиеся от незавершённых загрузок. Загрузки, всё ещё стоящие в очереди, сохранят свои файлы и продолжатся с места остановки.</string>
    <string name="settings_shell_caches_sfx_title">Очистить кэш звуковых эффектов?</string>
    <string name="settings_shell_caches_sfx_message">Это удалит перекодированные собственные звуковые файлы. Они пересоберутся автоматически при следующей загрузке звуков.</string>
    <string name="settings_shell_caches_emulator_apks_title">Очистить установщики эмуляторов?</string>
    <string name="settings_shell_caches_emulator_apks_message">Это удалит скачанные установочные APK эмуляторов. На установленные эмуляторы это не влияет.</string>
    <string name="settings_shell_caches_misc_downloads_title">Очистить прочие загрузки?</string>
    <string name="settings_shell_caches_misc_downloads_message">Это удалит обложки статусов друзей и скачанные пакеты драйверов GPU. На установленные драйверы это не влияет.</string>
    <string name="settings_shell_caches_shaders_catalog_title">Очистить каталог шейдеров?</string>
    <string name="settings_shell_caches_shaders_catalog_message">Это удалит скачанные шейдеры из каталога. Собственные шейдеры сохранятся, а шейдеры каталога будут скачаны заново по запросу.</string>
    <string name="settings_shell_caches_frames_title">Очистить оверлеи рамок?</string>
    <string name="settings_shell_caches_frames_message">Это удалит скачанные оверлеи рамок. Они будут скачаны заново по запросу при выборе.</string>
    <string name="settings_shell_caches_steam_downloads_title">Очистить данные загрузок Steam?</string>
    <string name="settings_shell_caches_steam_downloads_message">Это удалит подготовленные загрузки Steam и очистит очередь загрузок. На установленные игры это не влияет, но частичные загрузки начнутся заново.</string>

