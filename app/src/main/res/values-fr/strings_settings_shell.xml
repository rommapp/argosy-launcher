    <string name="settings_shell_modal_romm_signout_title">Se déconnecter de RomM ?</string>
    <plurals name="settings_shell_romm_signout_pending_message">
        <item quantity="one">%1$d sauvegarde sera envoyée d\'abord. Une fois tout sur votre serveur, les sauvegardes, états et réglages en cache de ce compte sont supprimés de cet appareil. Vos jeux téléchargés restent.</item>
        <item quantity="many">%1$d sauvegardes seront envoyées d\'abord. Une fois tout sur votre serveur, les sauvegardes, états et réglages en cache de ce compte sont supprimés de cet appareil. Vos jeux téléchargés restent.</item>
        <item quantity="other">%1$d sauvegardes seront envoyées d\'abord. Une fois tout sur votre serveur, les sauvegardes, états et réglages en cache de ce compte sont supprimés de cet appareil. Vos jeux téléchargés restent.</item>
    </plurals>
    <string name="settings_shell_romm_signout_message">Les sauvegardes, états et réglages en cache de ce compte sont supprimés de cet appareil, et tout ce qui a déjà été envoyé reste sur votre serveur. Vos jeux téléchargés restent.</string>
    <string name="settings_shell_modal_romm_signout_confirm">Se déconnecter</string>
    <string name="settings_shell_romm_signout_blocked_title">Données non envoyées</string>
    <string name="settings_shell_romm_signout_blocked_message">Ce compte a encore %1$s qui n\'ont pas pu être envoyés. Se déconnecter maintenant les supprime.</string>
    <string name="settings_shell_romm_signout_blocked_cancel">Rester connecté</string>
    <string name="settings_shell_romm_signout_blocked_confirm">Supprimer et se déconnecter</string>

    <string name="settings_shell_modal_reset_save_cache_title">Réinitialiser le cache de sauvegardes ?</string>
    <string name="settings_shell_modal_reset_save_cache_message">Cela supprimera tous les instantanés de sauvegarde mis en cache localement et les opérations de synchro en attente. Vos fichiers de sauvegarde réels et les sauvegardes du serveur ne sont pas affectés.</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">Réinitialiser</string>

    <string name="settings_shell_modal_clear_save_path_cache_title">Vider le cache des chemins de sauvegarde ?</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">Cela effacera tous les chemins de fichiers de sauvegarde détectés. Les chemins seront redétectés à la prochaine synchro. À utiliser si les sauvegardes se synchronisent au mauvais endroit.</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">Vider</string>

    <string name="settings_shell_modal_secure_saves_off_title">Désactiver les sauvegardes sécurisées ?</string>
    <string name="settings_shell_modal_secure_saves_off_message">Désactiver cette option désactive le mode hardcore de RetroAchievements. Les jeux se lanceront en mode casual jusqu\'à ce que les sauvegardes sécurisées soient réactivées.</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">Désactiver</string>

    <string name="settings_shell_modal_clear_state_cache_title">Vider le cache des états ?</string>
    <string name="settings_shell_modal_clear_state_cache_message">Cela supprimera tous les instantanés d\'état mis en cache localement et leurs opérations de synchro en attente. Les fichiers de sauvegarde et les copies serveur ne sont pas affectés.</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">Vider</string>

    <string name="settings_shell_modal_caches_clear_confirm">Vider</string>

    <string name="settings_shell_modal_delete_core_title">Supprimer le core ?</string>
    <string name="settings_shell_modal_delete_core_message">Le core est supprimé de cet appareil. Les jeux configurés pour l\'utiliser devront le retélécharger avant de pouvoir se lancer.</string>
    <string name="settings_shell_modal_delete_core_confirm">Supprimer</string>

    <string name="settings_shell_modal_sync_saves_title">Synchroniser les sauvegardes ?</string>
    <string name="settings_shell_modal_sync_saves_message">Cela analysera tous les jeux téléchargés à la recherche de sauvegardes modifiées et les synchronisera avec le serveur. Les sauvegardes locales plus récentes que la dernière synchro seront envoyées, et les sauvegardes serveur plus récentes seront téléchargées.</string>
    <string name="settings_shell_modal_sync_saves_confirm">Synchroniser</string>

