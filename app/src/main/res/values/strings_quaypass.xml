<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Owner: ui/screens/quaypass, ui/screens/doodle, ui/screens/secondaryhome
      Key prefixes: quaypass_, doodle_, secondaryhome_
      Keys are named for the usage site, never for the English text, and identical English
      is never shared between two usage sites.
    -->

    <!-- ============================ QuayPass check-in screen ============================ -->

    <!-- Heading at the top of the Check-In screen. Noun phrase naming the feature: passively
         meeting other Argosy users nearby. Not a verb. -->
    <string name="quaypass_checkin_header_title">Check-In</string>

    <!-- Status line under the heading while the radio is actively looking for nearby users.
         Verb in the continuous form. -->
    <string name="quaypass_checkin_state_running">Listening for nearby travelers...</string>
    <!-- Status line shown when the user has turned Check-In off. Statement. -->
    <string name="quaypass_checkin_state_disabled">QuayPass is off</string>
    <!-- Status line shown when the device has no Argosy account linked yet. Imperative sentence
         telling the user what to do. -->
    <string name="quaypass_checkin_state_not_linked">Link your Argosy account to check in</string>
    <!-- Status line shown while this device registers itself with the server for the first time.
         Verb in the continuous form. -->
    <string name="quaypass_checkin_state_awaiting_registration">Registering with the server...</string>
    <!-- Status line shown when registration finished but the device still needs to fetch its
         encounter credential. Imperative sentence. -->
    <string name="quaypass_checkin_state_awaiting_credential">Connect to finish setting up your pass</string>
    <!-- Status line shown when the device's stored credential has expired and needs replacing.
         Imperative sentence. -->
    <string name="quaypass_checkin_state_key_expired">Reconnect to refresh your pass</string>
    <!-- Status line shown when the server rejected this device's credential outright. Statement,
         not an instruction. -->
    <string name="quaypass_checkin_state_credential_rejected">Server key mismatch</string>
    <!-- Status line shown when the device's Bluetooth radio is turned off. Imperative sentence. -->
    <string name="quaypass_checkin_state_bluetooth_off">Turn on Bluetooth to check in</string>
    <!-- Status line shown when the app lacks the Bluetooth permission it needs. Statement of what
         is missing, not an instruction. -->
    <string name="quaypass_checkin_state_permissions_missing">Bluetooth permission needed</string>
    <!-- Status line shown when the device's hardware cannot do the Bluetooth exchange this feature
         needs. Statement. -->
    <string name="quaypass_checkin_state_ble_unsupported">This device can\'t exchange nearby</string>

    <!-- Footer hint bound to the spare button when the focused traveler has already sent this
         user a friend request. Verb: takes them up on it. -->
    <string name="quaypass_checkin_footer_accept">Accept</string>
    <!-- Footer hint bound to the spare button when the focused traveler has not been asked yet.
         Verb phrase: sends them a friend request. -->
    <string name="quaypass_checkin_footer_add_friend">Add Friend</string>
    <!-- Footer hint bound to the shortcut button on the Check-In screen. Noun: opens the editor
         for the greeting shown to travelers this device passes. -->
    <string name="quaypass_checkin_footer_greeting">Greeting</string>
    <!-- Footer hint on the Check-In screen. Verb: returns to the previous screen. -->
    <string name="quaypass_checkin_footer_back">Back</string>
    <!-- Footer hint on the Check-In screen. Verb: up and down move through the list of
         travelers. -->
    <string name="quaypass_checkin_footer_scroll">Scroll</string>

    <!-- Heading shown when this device has not passed any other travelers yet. Statement. -->
    <string name="quaypass_checkin_empty_title">No travelers yet</string>
    <!-- Body under that heading, explaining what will make the list start filling in. -->
    <string name="quaypass_checkin_empty_message">Take Argosy with you. You\'ll meet other players passively when you\'re nearby.</string>

    <!-- Name shown for a traveler card when the account has no display name set. %1$s is the
         account's handle; the "@" marks it as a handle rather than a full name. -->
    <string name="quaypass_checkin_card_name_fallback">\@%1$s</string>
    <!-- Second line under a traveler's display name, showing their handle underneath it. %1$s is
         the handle; the "@" marks it as a handle rather than a full name. -->
    <string name="quaypass_checkin_card_username_subtitle">\@%1$s</string>
    <!-- Tag on a traveler card for someone this user has blocked. Adjective describing the
         relationship, not a command. -->
    <string name="quaypass_checkin_card_blocked">Blocked</string>
    <!-- Tag on a traveler card for someone who has already sent this user a friend request. Verb
         phrase describing what they did. -->
    <string name="quaypass_checkin_card_request_received">Wants to add you</string>
    <!-- Tag on a traveler card for someone this user has already asked to be friends with. Noun
         phrase describing the pending request. -->
    <string name="quaypass_checkin_card_request_sent">Friend request sent</string>
    <!-- Second line on a traveler card naming the game they were last seen playing. %1$s is the
         game's title. -->
    <string name="quaypass_checkin_card_last_played">Played %1$s</string>
    <!-- Timestamp line on a traveler card met more than once. %1$d is how many times this user has
         passed them, %2$s a phrase like "2 hours ago" for the most recent time. -->
    <string name="quaypass_checkin_card_meet_count">Met %1$d times &#183; %2$s</string>
    <!-- Small badge on a traveler card who is already a friend. Noun, singular. -->
    <string name="quaypass_checkin_card_friend_badge">Friend</string>
    <!-- Small chip on a traveler card showing the tickets just earned for meeting them. %1$d is
         the amount; the leading "+" marks it as a gain. -->
    <string name="quaypass_checkin_card_ticket_award">+%1$d</string>

    <!-- Number of tickets the user has banked from Check-In encounters, shown in a chip on the
         Check-In screen. %1$d is the balance. -->
    <plurals name="quaypass_ticket_balance_chip_count">
        <item quantity="one">%1$d ticket</item>
        <item quantity="other">%1$d tickets</item>
    </plurals>

    <!-- =========================== QuayPass greeting editor =========================== -->

    <!-- Heading of the modal that edits the message shown to travelers this device passes. Noun,
         not a verb. -->
    <string name="quaypass_greeting_modal_title">Greeting</string>
    <!-- Footer hint on that modal. Verb: keeps the typed message. -->
    <string name="quaypass_greeting_modal_footer_save">Save</string>
    <!-- Footer hint on that modal. Verb: closes it without keeping changes. -->
    <string name="quaypass_greeting_modal_footer_cancel">Cancel</string>
    <!-- Explanation above the text field. Statement describing when the message is shown. -->
    <string name="quaypass_greeting_modal_description">Shown to travelers you pass at Check-In.</string>
    <!-- Grey text inside the empty greeting field, offered as an example greeting. -->
    <string name="quaypass_greeting_modal_placeholder">Hi there!</string>

    <!-- ================================== Doodle editor ================================== -->

    <!-- Spoken description of the pen tool icon. Noun naming the drawing tool, not a verb. -->
    <string name="doodle_tool_selector_pen_description">Pen</string>
    <!-- Spoken description of the line tool icon. Noun naming the drawing tool. -->
    <string name="doodle_tool_selector_line_description">Line</string>
    <!-- Spoken description of the fill tool icon. Noun naming the drawing tool, not the verb "to
         fill". -->
    <string name="doodle_tool_selector_fill_description">Fill</string>

    <!-- Spoken description of the undo icon. Verb naming the action. -->
    <string name="doodle_undo_redo_undo_description">Undo</string>
    <!-- Visible label under the undo icon. Verb naming the action. -->
    <string name="doodle_undo_redo_undo_label">Undo</string>
    <!-- Spoken description of the redo icon. Verb naming the action. -->
    <string name="doodle_undo_redo_redo_description">Redo</string>
    <!-- Visible label under the redo icon. Verb naming the action. -->
    <string name="doodle_undo_redo_redo_label">Redo</string>

    <!-- Footer hint while the canvas is selected. Verb: the directions move the cursor around the
         canvas. -->
    <string name="doodle_footer_canvas_move">Move</string>
    <!-- Footer hint on the confirm button while a line is being drawn with the line tool. Verb:
         places the far end of the line. -->
    <string name="doodle_footer_canvas_draw_end">End</string>
    <!-- Footer hint on the confirm button while freehand drawing with the pen tool. Verb: lifts
         the pen. -->
    <string name="doodle_footer_canvas_draw_stop">Stop</string>
    <!-- Footer hint on the confirm button when the line tool is selected and no line is started
         yet. Verb: places the line's first end. -->
    <string name="doodle_footer_canvas_draw_start">Start</string>
    <!-- Footer hint on the confirm button when the fill tool is selected. Verb: floods the area
         under the cursor with the current colour. Not the noun "a fill". -->
    <string name="doodle_footer_canvas_draw_fill">Fill</string>
    <!-- Footer hint on the confirm button in any other canvas state. Verb: begins drawing with the
         pen tool. -->
    <string name="doodle_footer_canvas_draw_default">Draw</string>
    <!-- Footer hint while the canvas is selected. Noun, plural: switches to the next drawing
         tool. -->
    <string name="doodle_footer_canvas_tool">Tool</string>

    <!-- Footer hint while the colour palette is selected. Verb: the directions move the cursor
         between the colour swatches. -->
    <string name="doodle_footer_palette_select">Select</string>
    <!-- Footer hint while the colour palette is selected. Verb: makes the swatch under the cursor
         the active colour. -->
    <string name="doodle_footer_palette_pick">Pick</string>

    <!-- Footer hint while the canvas size selector is focused. Noun phrase: left and right change
         which canvas size is chosen. -->
    <string name="doodle_footer_size_adjust">Size</string>
    <!-- Footer hint while the canvas size selector is focused. Verb: applies the highlighted
         size. -->
    <string name="doodle_footer_size_confirm">Confirm</string>

    <!-- Footer hint while the undo button is focused and there is something to undo. Verb naming
         the action. -->
    <string name="doodle_footer_undo">Undo</string>
    <!-- Footer hint while the redo button is focused and there is something to redo. Verb naming
         the action. -->
    <string name="doodle_footer_redo">Redo</string>

    <!-- Footer hint while the linked-game row is focused. Verb: opens the game picker. -->
    <string name="doodle_footer_game_select">Select</string>
    <!-- Footer hint while the linked-game row is focused and a game is already linked. Verb:
         removes the link. -->
    <string name="doodle_footer_game_clear">Clear</string>

    <!-- Footer hint shown once the canvas has any drawing on it. Verb: finishes editing and saves
         the doodle. -->
    <string name="doodle_footer_done">Done</string>
    <!-- Footer hint on the back button while a stroke or line is in progress. Verb: abandons the
         in-progress stroke rather than leaving the screen. -->
    <string name="doodle_footer_back_cancel">Cancel</string>
    <!-- Footer hint on the back button when the canvas has unsaved drawing and nothing is
         in progress. Verb: opens the confirmation to leave without saving. -->
    <string name="doodle_footer_back_discard">Discard</string>
    <!-- Footer hint on the back button when the canvas is empty. Verb: leaves the screen. -->
    <string name="doodle_footer_back_default">Back</string>

    <!-- Stands in for the linked game's title on the linked-game row when no game is linked yet.
         Noun, singular. -->
    <string name="doodle_game_section_fallback">Game</string>

    <!-- Heading of the modal that links a game to the doodle being drawn. Verb phrase,
         imperative. -->
    <string name="doodle_game_picker_title">Select Game</string>
    <!-- Footer hint in that modal while the search field is focused. Verb: moves focus down into
         the results list. -->
    <string name="doodle_game_picker_footer_browse">Browse</string>
    <!-- Footer hint in that modal while the results list is focused. Verb: up and down move
         between the results. -->
    <string name="doodle_game_picker_footer_navigate">Navigate</string>
    <!-- Footer hint in that modal while the results list is focused. Verb: links the game under
         the cursor. -->
    <string name="doodle_game_picker_footer_select">Select</string>
    <!-- Footer hint in that modal. Verb: closes it without changing the link. -->
    <string name="doodle_game_picker_footer_cancel">Cancel</string>
    <!-- Grey text inside the empty search field. Verb phrase addressed to the user. -->
    <string name="doodle_game_picker_search_placeholder">Search games...</string>
    <!-- First row of the results list, standing for "no game linked". Noun phrase. -->
    <string name="doodle_game_picker_no_game">No game</string>

    <!-- Heading of the confirmation shown when leaving a doodle with unsaved drawing. Question. -->
    <string name="doodle_discard_dialog_title">Discard Doodle?</string>
    <!-- Body of that confirmation. Two sentences: a statement, then a question. -->
    <string name="doodle_discard_dialog_message">You have unsaved changes. Are you sure you want to discard your doodle?</string>
    <!-- Option in that confirmation. Verb: leaves without saving. -->
    <string name="doodle_discard_dialog_discard">Discard</string>
    <!-- Option in that confirmation. Verb phrase: returns to the canvas instead. -->
    <string name="doodle_discard_dialog_keep_editing">Keep Editing</string>

    <!-- ============================== Secondary home (companion) ========================== -->

    <!-- Heading at the top of the companion screen's app drawer. Noun phrase naming what the
         drawer lists. -->
    <string name="secondaryhome_drawer_all_apps_title">All Apps</string>
    <!-- Spoken description of the pin badge on an app icon in the drawer, shown when that app is
         pinned to the companion home bar. Adjective describing the app's state. -->
    <string name="secondaryhome_drawer_pinned_description">Pinned</string>
</resources>
