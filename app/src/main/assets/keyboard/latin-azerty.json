{
  "id": "latin-azerty",
  "version": 1,
  "script": "Latn",
  "locales": ["fr"],
  "composer": "none",
  "pages": {
    "letters": {
      "shift": "upper",
      "rows": [
        [{"k": "1", "s": "!"}, {"k": "2", "s": "@"}, {"k": "3", "s": "#"}, {"k": "4", "s": "$"}, {"k": "5", "s": "%"}, {"k": "6", "s": "^"}, {"k": "7", "s": "&"}, {"k": "8", "s": "*"}, {"k": "9", "s": "("}, {"k": "0", "s": ")"}],
        ["a", "z", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["q", "s", "d", "f", "g", "h", "j", "k", "l", "m"],
        [{"fn": "shift", "w": 2}, "w", "x", "c", "v", "b", "n", {"fn": "backspace", "w": 2}]
      ]
    },
    "symbols": {"ref": "shared-symbols", "asciiOnly": true}
  },
  "accents": {
    "a": ["à", "â", "æ", "á", "ä", "ã", "å", "ā"],
    "e": ["è", "é", "ê", "ë", "ē", "ė", "ę"],
    "c": ["ç", "ć", "č"],
    "n": ["ñ", "ń"],
    "s": ["ß", "ś", "š"],
    "i": ["î", "ï", "ì", "í", "ī", "į", "ı"],
    "o": ["ô", "œ", "ö", "ò", "ó", "õ", "ø", "ō", "ő"],
    "u": ["ù", "û", "ü", "ú", "ū", "ů", "ű"],
    "y": ["ÿ", "ý"],
    "z": ["ž", "ź", "ż"],
    "l": ["ł", "ľ", "ĺ"],
    "g": ["ğ"],
    "d": ["ď", "đ", "ð"],
    "r": ["ř", "ŕ"],
    "t": ["ť", "þ"],
    "$": ["€", "£", "¥", "₹", "₩", "₽"]
  },
  "accentDefault": {
    "fr": {"e": "é"}
  }
}
