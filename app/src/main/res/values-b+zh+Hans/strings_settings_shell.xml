    <string name="settings_shell_modal_romm_signout_title">退出RomM登录？</string>
    <plurals name="settings_shell_romm_signout_pending_message">
        <item quantity="other">将先上传%1$d个存档。全部同步到服务器后，此账户在本设备上缓存的存档、即时存档和设置会被移除，已下载的游戏会保留。</item>
    </plurals>
    <string name="settings_shell_romm_signout_message">此账户在本设备上缓存的存档、即时存档和设置会被移除，已上传的内容会保留在服务器上，已下载的游戏会保留。</string>
    <string name="settings_shell_modal_romm_signout_confirm">退出登录</string>

    <string name="settings_shell_modal_reset_save_cache_title">重置存档缓存？</string>
    <string name="settings_shell_modal_reset_save_cache_message">这将删除所有本地缓存的存档快照和待处理的同步操作。你的实际存档文件和服务器上的存档不受影响。</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">重置</string>

    <string name="settings_shell_modal_clear_save_path_cache_title">清除存档路径缓存？</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">这将清除所有已检测到的存档文件路径。路径会在下次同步时重新检测。如果存档同步到了错误的位置，可以使用此功能。</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">清除</string>

    <string name="settings_shell_modal_secure_saves_off_title">关闭安全存档？</string>
    <string name="settings_shell_modal_secure_saves_off_message">关闭此功能会禁用RetroAchievements的硬核模式。在重新打开安全存档之前，游戏将以休闲模式启动。</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">关闭</string>

    <string name="settings_shell_modal_clear_state_cache_title">清除即时存档缓存？</string>
    <string name="settings_shell_modal_clear_state_cache_message">这将删除所有本地缓存的即时存档快照及其待处理的同步操作。存档文件和服务器副本不受影响。</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">清除</string>

    <string name="settings_shell_modal_caches_clear_confirm">清除</string>

    <string name="settings_shell_modal_delete_core_title">删除核心？</string>
    <string name="settings_shell_modal_delete_core_message">该核心将从本设备中删除。设置为使用它的游戏需要重新下载该核心才能运行。</string>
    <string name="settings_shell_modal_delete_core_confirm">删除</string>

    <string name="settings_shell_modal_sync_saves_title">同步存档？</string>
    <string name="settings_shell_modal_sync_saves_message">这将扫描所有已下载的游戏以查找存档变化，并与服务器同步。比上次同步更新的本地存档会被上传，比上次同步更新的服务器存档会被下载。</string>
    <string name="settings_shell_modal_sync_saves_confirm">同步</string>

