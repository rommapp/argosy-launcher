    <string name="settings_shell_modal_romm_signout_title">¿Cerrar sesión en RomM?</string>
    <plurals name="settings_shell_romm_signout_pending_message">
        <item quantity="one">%1$d partida guardada se subirá primero. Una vez que todo esté en tu servidor, las partidas guardadas, estados y ajustes en caché de esta cuenta se eliminan de este dispositivo. Tus juegos descargados permanecen.</item>
