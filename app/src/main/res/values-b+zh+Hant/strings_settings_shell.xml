    <string name="settings_shell_modal_migrate_platform_fallback">平台</string>
    <string name="settings_shell_modal_migrate_platform_message">要將已下載的遊戲移動到新位置嗎？檔案會先複製過去，再從舊位置移除。</string>
    <string name="settings_shell_modal_migrate_platform_confirm">遷移</string>
    <string name="settings_shell_modal_migrate_platform_skip">略過</string>

    <string name="settings_shell_modal_purge_platform_title">要清除%1$s嗎？</string>
    <string name="settings_shell_modal_purge_platform_fallback">平台</string>
    <string name="settings_shell_modal_purge_platform_message">這會刪除全部%1$d款遊戲及其本機ROM檔案，且無法復原。</string>
    <string name="settings_shell_modal_purge_platform_confirm">清除</string>

    <string name="settings_shell_modal_sync_first_title">請先同步存檔</string>
    <string name="settings_shell_modal_sync_first_message">請先同步存檔，目前還有%1$d個待處理。現在重設收藏庫會永久捨棄尚未上傳的存檔。</string>
    <string name="settings_shell_modal_sync_first_confirm">立即同步</string>

    <string name="settings_shell_modal_reset_library_title">要重設收藏庫嗎？</string>
    <string name="settings_shell_modal_reset_library_message">這會清除資料庫與圖片快取。已下載的檔案會保留在裝置上。將永久遺失：遊玩時間、本機合輯、下載紀錄、存檔同步狀態，以及各遊戲的個別設定。您之後需要重新同步收藏庫。</string>
    <string name="settings_shell_modal_reset_library_confirm">重設</string>

