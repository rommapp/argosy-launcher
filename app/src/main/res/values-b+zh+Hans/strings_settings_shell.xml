    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">清除图片缓存？</string>
    <string name="settings_shell_caches_image_message">这将删除所有缓存的封面、背景和截图。浏览时图片会从服务器重新下载。</string>
    <string name="settings_shell_caches_rom_extraction_title">清除已解压的ROM？</string>
    <string name="settings_shell_caches_rom_extraction_message">这将删除压缩游戏的解压工作副本。下次每个游戏启动时会重新解压。</string>
    <string name="settings_shell_caches_rom_staging_title">清除废弃的暂存文件？</string>
    <string name="settings_shell_caches_rom_staging_message">这将删除因下载未完成而遗留的内部工作文件。仍在队列中的下载会保留其文件，并从中断处继续。</string>
    <string name="settings_shell_caches_sfx_title">清除音效缓存？</string>
    <string name="settings_shell_caches_sfx_message">这将删除转码后的自定义音效文件。下次加载音效时会自动重新生成。</string>
    <string name="settings_shell_caches_emulator_apks_title">清除模拟器安装包？</string>
    <string name="settings_shell_caches_emulator_apks_message">这将删除已下载的模拟器安装APK。已安装的模拟器不受影响。</string>
    <string name="settings_shell_caches_misc_downloads_title">清除其他下载内容？</string>
    <string name="settings_shell_caches_misc_downloads_message">这将删除好友状态封面和已下载的GPU驱动安装包。已安装的驱动不受影响。</string>
    <string name="settings_shell_caches_shaders_catalog_title">清除着色器目录？</string>
    <string name="settings_shell_caches_shaders_catalog_message">这将删除已下载的目录着色器。自定义着色器会保留，目录着色器会按需重新下载。</string>
    <string name="settings_shell_caches_frames_title">清除边框素材？</string>
    <string name="settings_shell_caches_frames_message">这将删除已下载的边框素材。选择时会按需重新下载。</string>
    <string name="settings_shell_caches_steam_downloads_title">清除Steam下载数据？</string>
    <string name="settings_shell_caches_steam_downloads_message">这将删除已暂存的Steam下载内容并清空下载队列。已安装的游戏不受影响，但未完成的下载会从头重新开始。</string>

