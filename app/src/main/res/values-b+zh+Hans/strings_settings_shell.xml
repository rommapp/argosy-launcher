    <string name="settings_shell_modal_sync_first_confirm">立即同步</string>

    <string name="settings_shell_modal_reset_library_title">重置库？</string>
    <string name="settings_shell_modal_reset_library_message">清除数据库和图片缓存。已下载的文件会保留在磁盘上。将永久丢失：游戏时长、本地合集、下载记录、存档同步状态和每个游戏的单独设置。你需要重新同步你的库。</string>
    <string name="settings_shell_modal_reset_library_confirm">重置</string>

