    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">Bildercache leeren?</string>
    <string name="settings_shell_caches_image_message">Dadurch werden alle zwischengespeicherten Cover, Hintergründe und Screenshots gelöscht. Bilder werden beim Durchsuchen erneut vom Server geladen.</string>
    <string name="settings_shell_caches_rom_extraction_title">Extrahierte ROMs leeren?</string>
    <string name="settings_shell_caches_rom_extraction_message">Dadurch werden extrahierte Arbeitskopien komprimierter Spiele gelöscht. Sie werden beim nächsten Start jedes Spiels erneut extrahiert.</string>
    <string name="settings_shell_caches_rom_staging_title">Verwaiste Zwischendateien leeren?</string>
    <string name="settings_shell_caches_rom_staging_message">Dadurch werden interne Arbeitsdateien gelöscht, die von nie abgeschlossenen Downloads zurückgeblieben sind. Downloads, die noch in der Warteschlange stehen, behalten ihre eigenen und setzen dort fort, wo sie aufgehört haben.</string>
    <string name="settings_shell_caches_sfx_title">Soundeffekt-Cache leeren?</string>
    <string name="settings_shell_caches_sfx_message">Dadurch werden transkodierte eigene Sounddateien gelöscht. Sie werden beim nächsten Laden der Sounds automatisch neu erstellt.</string>
    <string name="settings_shell_caches_emulator_apks_title">Emulator-Installer leeren?</string>
    <string name="settings_shell_caches_emulator_apks_message">Dadurch werden heruntergeladene Emulator-Installations-APKs gelöscht. Installierte Emulatoren sind davon nicht betroffen.</string>
    <string name="settings_shell_caches_misc_downloads_title">Sonstige Downloads leeren?</string>
    <string name="settings_shell_caches_misc_downloads_message">Dadurch werden Freundes-Präsenzbilder und heruntergeladene GPU-Treiberpakete gelöscht. Installierte Treiber sind davon nicht betroffen.</string>
    <string name="settings_shell_caches_shaders_catalog_title">Shader-Katalog leeren?</string>
    <string name="settings_shell_caches_shaders_catalog_message">Dadurch werden heruntergeladene Katalog-Shader gelöscht. Eigene Shader bleiben erhalten, und Katalog-Shader werden bei Bedarf erneut heruntergeladen.</string>
    <string name="settings_shell_caches_frames_title">Rahmen-Overlays leeren?</string>
    <string name="settings_shell_caches_frames_message">Dadurch werden heruntergeladene Rahmen-Overlays gelöscht. Sie werden bei Auswahl bei Bedarf erneut heruntergeladen.</string>
    <string name="settings_shell_caches_steam_downloads_title">Steam-Download-Daten leeren?</string>
    <string name="settings_shell_caches_steam_downloads_message">Dadurch werden vorbereitete Steam-Downloads gelöscht und die Download-Warteschlange geleert. Installierte Spiele sind davon nicht betroffen, aber unvollständige Downloads beginnen wieder bei null.</string>

