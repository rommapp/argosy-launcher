          where the English matches, so either can be reworded alone. -->
    <string name="notif_sync_library_start_failed_title">Falha ao iniciar a sincronização</string>
    <string name="notif_sync_library_progress_title">Sincronizando a biblioteca</string>
    <!-- Shown before the first platform is reported. -->
    <string name="notif_sync_library_progress_starting">Iniciando...</string>
    <!-- %1$s is the platform being synced, %2$d games done of %3$d. -->
    <string name="notif_sync_library_progress_platform_games">%1$s (%2$d/%3$d jogos)</string>
    <string name="notif_sync_library_complete_title">Sincronização completa</string>
    <!-- Counts of games. "added" and "updated" are past-tense verbs describing what sync did. -->
    <string name="notif_sync_library_complete_counts">%1$d adicionados, %2$d atualizados</string>
    <string name="notif_sync_library_complete_counts_with_removed">%1$d adicionados, %2$d atualizados, %3$d removidos</string>
    <string name="notif_sync_library_completed_with_errors_title">Sincronização concluída com erros</string>
    <plurals name="notif_sync_library_failed_platforms">
        <item quantity="one">%1$d plataforma falhou</item>
        <item quantity="many">%1$d plataformas falharam</item>
        <item quantity="other">%1$d plataformas falharam</item>
    </plurals>
    <string name="notif_sync_library_failed_title">Falha na sincronização</string>

    <!-- Explanations for a sync that could not run, chosen by matching the server error. -->
    <string name="notif_sync_failure_timeout">O servidor demorou muito para responder. Pode estar ocupado ou sua biblioteca é muito grande.</string>
    <string name="notif_sync_failure_unreachable">Não é possível alcançar o servidor. Verifique sua conexão e o endereço do servidor.</string>
    <string name="notif_sync_failure_connection_lost">Conexão com o servidor perdida. A sincronização retoma de onde parou na próxima vez.</string>
    <string name="notif_sync_failure_unknown">Falha na sincronização. Tente novamente.</string>

    <!-- Single-platform sync notifications. %1$s is the platform name. -->
    <string name="notif_sync_platform_progress_title">Sincronizando %1$s</string>
    <string name="notif_sync_platform_progress_fetching">Buscando jogos...</string>
    <!-- Subtitle while one platform's games are written. The title already names the platform,
          so this is the count alone. %1$d games done of %2$d. -->
    <string name="notif_sync_platform_progress_games">%1$d/%2$d jogos</string>
    <string name="notif_sync_platform_complete_title">Sincronização de %1$s concluída</string>
    <string name="notif_sync_platform_complete_counts">%1$d adicionados, %2$d atualizados</string>
    <string name="notif_sync_platform_complete_counts_with_removed">%1$d adicionados, %2$d atualizados, %3$d removidos</string>
    <string name="notif_sync_platform_completed_with_errors_title">Sincronização concluída com erros</string>
    <string name="notif_sync_platform_error_unknown">Erro desconhecido</string>
    <string name="notif_sync_platform_failed_title">Falha na sincronização</string>

    <!-- Brief message after a game review reached the social server. Past tense statement. -->
    <string name="notif_review_saved">Avaliação publicada</string>
    <!-- Brief message after a game review was removed from the social server. -->
    <string name="notif_review_deleted">Avaliação removida</string>
    <!-- Error when a review write was attempted without a social connection. -->
    <string name="notif_review_error_offline">Não conectado ao Argosy Social</string>
    <!-- Error when a like, comment, post, follow, friend or notification action was attempted
          without a social connection, so it was not sent. -->
    <string name="notif_social_error_offline">Não conectado ao Argosy Social</string>
    <!-- Error when the server refused the review text for exceeding its length limit. -->
    <string name="notif_review_error_too_long">A avaliação é longa demais</string>
    <!-- Error when the server could not read the review it was sent. -->
    <string name="notif_review_error_invalid">O servidor não pôde ler a avaliação</string>
    <!-- Error when the server failed to store the review. -->
    <string name="notif_review_error_server">O servidor não pôde salvar a avaliação</string>

    <!-- Trailing count on the progress bar when other jobs are running behind the one shown.
          %1$d is how many others, never zero. -->
    <plurals name="notification_persistent_also_running">
        <item quantity="one">+%1$d a mais</item>
        <item quantity="many">+%1$d a mais</item>
        <item quantity="other">+%1$d a mais</item>
    </plurals>

    <!-- Shown when a monitor or TV is plugged in that this device has no saved arrangement for.
          "Display" here means a physical screen, not the act of displaying something. -->
    <string name="notif_new_display_title">Novo display detectado</string>
    <!-- Follows a controller button icon, so it reads as "[X] Set up displays". Keep it short
          enough to sit on one line beside the icon. -->
    <string name="notif_new_display_action">Configurar displays</string>
</resources>
