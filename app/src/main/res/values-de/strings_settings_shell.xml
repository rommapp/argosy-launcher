    <!-- ===== SettingsScreen: confirm modals ===== -->

    <string name="settings_shell_modal_builtin_migration_save_title">Spielstanddateien migrieren?</string>
    <string name="settings_shell_modal_builtin_migration_state_title">Savestate-Dateien migrieren?</string>
    <string name="settings_shell_modal_builtin_migration_save_message">Das Ziel enthält bereits %1$d Spielstanddateien. Vorhandene Dateien vom alten Speicherort verschieben? Dabei werden Konflikte überschrieben.</string>
    <string name="settings_shell_modal_builtin_migration_state_message">Das Ziel enthält bereits %1$d Savestate-Dateien. Vorhandene Dateien vom alten Speicherort verschieben? Dabei werden Konflikte überschrieben.</string>
    <string name="settings_shell_modal_builtin_migration_confirm">Migrieren</string>
    <string name="settings_shell_modal_builtin_migration_skip">Überspringen</string>

    <string name="settings_shell_modal_music_relocation_title">Musikdateien verschieben?</string>
    <string name="settings_shell_modal_music_relocation_message">Der aktuelle Musikordner enthält %1$d Dateien. An den neuen Speicherort verschieben? Dabei werden Konflikte überschrieben.</string>
    <string name="settings_shell_modal_music_relocation_confirm">Verschieben</string>
    <string name="settings_shell_modal_music_relocation_skip">Überspringen</string>

    <string name="settings_shell_modal_media_relocation_title">Heruntergeladene Medien verschieben?</string>
    <string name="settings_shell_modal_media_relocation_message">Der aktuelle Medienordner enthält %1$d Dateien. An den neuen Speicherort verschieben? Dabei werden Konflikte überschrieben.</string>
    <string name="settings_shell_modal_media_relocation_confirm">Verschieben</string>
    <string name="settings_shell_modal_media_relocation_leave">Belassen</string>

    <string name="settings_shell_modal_jellyfin_signout_title">Von Jellyfin abmelden?</string>
    <string name="settings_shell_modal_jellyfin_signout_message">Dieses Gerät vergisst Ihre Jellyfin-Anmeldung. Heruntergeladene Medien bleiben auf dem Gerät, und Ihr Verlauf bleibt auf dem Server.</string>
    <string name="settings_shell_modal_jellyfin_signout_confirm">Abmelden</string>

    <string name="settings_shell_modal_import_settings_title">Einstellungen importieren?</string>
    <string name="settings_shell_modal_import_settings_message">Wählen Sie eine Sicherungsdatei aus; die darin genannten Einstellungen ersetzen Ihre eigenen. Alles, was die Datei auslässt, bleibt unverändert, und Konten, Server, Sync-Status und Speicherorte werden nie übernommen.</string>
    <string name="settings_shell_modal_import_settings_confirm">Datei wählen</string>

    <string name="settings_shell_modal_migrate_downloads_title">Downloads migrieren?</string>
    <string name="settings_shell_modal_migrate_downloads_message">%1$d Spiele (%2$s) an den neuen Speicherort verschieben?</string>
    <string name="settings_shell_modal_migrate_downloads_confirm">Migrieren</string>
    <string name="settings_shell_modal_migrate_downloads_skip">Überspringen</string>

    <string name="settings_shell_modal_migrate_platform_title">%1$s-ROMs migrieren?</string>
    <string name="settings_shell_modal_migrate_platform_fallback">Plattform</string>
    <string name="settings_shell_modal_migrate_platform_message">Heruntergeladene Spiele an den neuen Speicherort verschieben? Dateien werden kopiert und dann vom alten Speicherort entfernt.</string>
    <string name="settings_shell_modal_migrate_platform_confirm">Migrieren</string>
    <string name="settings_shell_modal_migrate_platform_skip">Überspringen</string>

    <string name="settings_shell_modal_purge_platform_title">%1$s bereinigen?</string>
    <string name="settings_shell_modal_purge_platform_fallback">Plattform</string>
    <string name="settings_shell_modal_purge_platform_message">Dadurch werden alle %1$d Spiele und ihre lokalen ROM-Dateien gelöscht. Dies kann nicht rückgängig gemacht werden.</string>
    <string name="settings_shell_modal_purge_platform_confirm">Bereinigen</string>

    <string name="settings_shell_modal_sync_first_title">Zuerst Spielstände synchronisieren</string>
    <string name="settings_shell_modal_sync_first_message">Synchronisieren Sie zuerst Ihre Spielstände - %1$d ausstehend. Ein Zurücksetzen der Bibliothek würde nicht hochgeladene Spielstände endgültig verwerfen.</string>
    <string name="settings_shell_modal_sync_first_confirm">Jetzt synchronisieren</string>

    <string name="settings_shell_modal_reset_library_title">Bibliothek zurücksetzen?</string>
    <string name="settings_shell_modal_reset_library_message">Löscht die Datenbank und den Bildercache. Heruntergeladene Dateien bleiben erhalten. Endgültig verloren: Spielzeit, lokale Sammlungen, Downloadverlauf, Sync-Status der Spielstände und spielspezifische Einstellungen. Sie müssen Ihre Bibliothek neu synchronisieren.</string>
    <string name="settings_shell_modal_reset_library_confirm">Zurücksetzen</string>

    <plurals name="settings_shell_unsynced_saves_warning">
        <item quantity="one">%d nicht synchronisierter Spielstand geht verloren.</item>
        <item quantity="other">%d nicht synchronisierte Spielstände gehen verloren.</item>
    </plurals>

    <string name="settings_shell_modal_delete_game_soundtrack_title">%1$s löschen?</string>
    <string name="settings_shell_modal_delete_game_soundtrack_message">Entfernt alle heruntergeladenen Dateien für dieses Spiel.%1$s Wählen Sie, ob auch der Soundtrack gelöscht werden soll.</string>
    <string name="settings_shell_modal_delete_game_cancel">Abbrechen</string>
    <string name="settings_shell_modal_delete_game_only">Spiel löschen</string>
    <string name="settings_shell_modal_delete_game_with_soundtrack">Löschen + Soundtrack</string>

    <string name="settings_shell_modal_delete_game_plain_title">%1$s löschen?</string>
    <string name="settings_shell_modal_delete_game_plain_message">Entfernt alle heruntergeladenen Dateien für dieses Spiel.%1$s Dies kann nicht rückgängig gemacht werden.</string>
    <string name="settings_shell_modal_delete_game_plain_confirm">Spiel löschen</string>

    <string name="settings_shell_modal_romm_signout_title">Von RomM abmelden?</string>
    <plurals name="settings_shell_romm_signout_pending_message">
        <item quantity="one">%1$d Spielstand wird zuerst hochgeladen. Sobald alles auf Ihrem Server ist, werden die zwischengespeicherten Spielstände, Savestates und Einstellungen dieses Kontos von diesem Gerät entfernt. Ihre heruntergeladenen Spiele bleiben erhalten.</item>
        <item quantity="other">%1$d Spielstände werden zuerst hochgeladen. Sobald alles auf Ihrem Server ist, werden die zwischengespeicherten Spielstände, Savestates und Einstellungen dieses Kontos von diesem Gerät entfernt. Ihre heruntergeladenen Spiele bleiben erhalten.</item>
    </plurals>
    <string name="settings_shell_romm_signout_message">Die zwischengespeicherten Spielstände, Savestates und Einstellungen dieses Kontos werden von diesem Gerät entfernt, und alles bereits Hochgeladene bleibt auf Ihrem Server. Ihre heruntergeladenen Spiele bleiben erhalten.</string>
    <string name="settings_shell_modal_romm_signout_confirm">Abmelden</string>

    <string name="settings_shell_modal_reset_save_cache_title">Spielstand-Cache zurücksetzen?</string>
    <string name="settings_shell_modal_reset_save_cache_message">Dadurch werden alle lokal zwischengespeicherten Spielstand-Schnappschüsse und ausstehenden Sync-Vorgänge gelöscht. Ihre eigentlichen Spielstanddateien und Server-Spielstände sind davon nicht betroffen.</string>
    <string name="settings_shell_modal_reset_save_cache_confirm">Zurücksetzen</string>

    <string name="settings_shell_modal_clear_save_path_cache_title">Spielstand-Pfad-Cache leeren?</string>
    <string name="settings_shell_modal_clear_save_path_cache_message">Dadurch werden alle erkannten Spielstand-Pfade gelöscht. Pfade werden bei der nächsten Synchro neu erkannt. Verwenden Sie dies, wenn Spielstände am falschen Ort synchronisiert werden.</string>
    <string name="settings_shell_modal_clear_save_path_cache_confirm">Leeren</string>

    <string name="settings_shell_modal_secure_saves_off_title">Sichere Spielstände deaktivieren?</string>
    <string name="settings_shell_modal_secure_saves_off_message">Das Deaktivieren schaltet den RetroAchievements-Hardcore-Modus aus. Spiele starten im Casual-Modus, bis Sichere Spielstände wieder aktiviert wird.</string>
    <string name="settings_shell_modal_secure_saves_off_confirm">Deaktivieren</string>

    <string name="settings_shell_modal_clear_state_cache_title">Savestate-Cache leeren?</string>
    <string name="settings_shell_modal_clear_state_cache_message">Dadurch werden alle lokal zwischengespeicherten Savestate-Schnappschüsse und deren ausstehende Sync-Vorgänge gelöscht. Spielstanddateien und Server-Kopien sind davon nicht betroffen.</string>
    <string name="settings_shell_modal_clear_state_cache_confirm">Leeren</string>

    <string name="settings_shell_modal_caches_clear_confirm">Leeren</string>

    <string name="settings_shell_modal_delete_core_title">Core löschen?</string>
    <string name="settings_shell_modal_delete_core_message">Der Core wird von diesem Gerät entfernt. Spiele, die ihn verwenden, müssen ihn vor dem Start erneut herunterladen.</string>
    <string name="settings_shell_modal_delete_core_confirm">Löschen</string>

    <string name="settings_shell_modal_sync_saves_title">Spielstände synchronisieren?</string>
    <string name="settings_shell_modal_sync_saves_message">Dies durchsucht alle heruntergeladenen Spiele nach geänderten Spielständen und synchronisiert sie mit dem Server. Lokale Spielstände, die neuer als die letzte Synchro sind, werden hochgeladen, und neuere Server-Spielstände werden heruntergeladen.</string>
    <string name="settings_shell_modal_sync_saves_confirm">Synchronisieren</string>

