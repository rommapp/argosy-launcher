    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">Vider le cache d\'images ?</string>
    <string name="settings_shell_caches_image_message">Cela supprimera toutes les jaquettes, arrière-plans et captures d\'écran mis en cache. Les images seront retéléchargées depuis le serveur au fil de la navigation.</string>
    <string name="settings_shell_caches_rom_extraction_title">Vider les ROM extraites ?</string>
    <string name="settings_shell_caches_rom_extraction_message">Cela supprimera les copies de travail extraites des jeux compressés. Elles seront réextraites au prochain lancement de chaque jeu.</string>
    <string name="settings_shell_caches_rom_staging_title">Vider les fichiers temporaires abandonnés ?</string>
    <string name="settings_shell_caches_rom_staging_message">Cela supprimera les fichiers de travail internes laissés par des téléchargements jamais terminés. Les téléchargements encore en file d\'attente conservent les leurs et reprennent où ils s\'étaient arrêtés.</string>
    <string name="settings_shell_caches_sfx_title">Vider le cache des effets sonores ?</string>
    <string name="settings_shell_caches_sfx_message">Cela supprimera les fichiers sonores personnalisés transcodés. Ils seront reconstruits automatiquement au prochain chargement des sons.</string>
    <string name="settings_shell_caches_emulator_apks_title">Vider les installeurs d\'émulateurs ?</string>
    <string name="settings_shell_caches_emulator_apks_message">Cela supprimera les APK d\'installation d\'émulateurs téléchargés. Les émulateurs installés ne sont pas affectés.</string>
    <string name="settings_shell_caches_misc_downloads_title">Vider les téléchargements divers ?</string>
    <string name="settings_shell_caches_misc_downloads_message">Cela supprimera les images de présence des amis et les pilotes GPU téléchargés. Les pilotes installés ne sont pas affectés.</string>
    <string name="settings_shell_caches_shaders_catalog_title">Vider le catalogue de shaders ?</string>
    <string name="settings_shell_caches_shaders_catalog_message">Cela supprimera les shaders du catalogue téléchargés. Les shaders personnalisés sont conservés, et les shaders du catalogue seront retéléchargés à la demande.</string>
    <string name="settings_shell_caches_frames_title">Vider les cadres téléchargés ?</string>
    <string name="settings_shell_caches_frames_message">Cela supprimera les cadres téléchargés. Ils seront retéléchargés à la demande lors de leur sélection.</string>
    <string name="settings_shell_caches_steam_downloads_title">Vider les données de téléchargement Steam ?</string>
    <string name="settings_shell_caches_steam_downloads_message">Cela supprimera les téléchargements Steam en préparation et videra la file d\'attente. Les jeux installés ne sont pas affectés, mais les téléchargements partiels repartiront de zéro.</string>

