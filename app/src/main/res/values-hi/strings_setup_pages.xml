<resources>
    <string name="setup_home_title">होम ऐप</string>
    <string name="setup_home_purpose">दोनों स्क्रीन चलाने के लिए Argosy को आपका होम ऐप होना चाहिए।</string>
    <string name="setup_home_body">Argosy को अपना होम ऐप बनाएं, ताकि होम बटन इसे खोले और दोनों स्क्रीन साथ काम करें।</string>
    <string name="setup_home_body_set">Argosy आपका होम ऐप है।</string>
    <string name="setup_home_decline_note">होम ऐप बने बिना Argosy आपके गेम डाउनलोड और सिंक करता है, पर दूसरी स्क्रीन नहीं चलाता। दूसरे ऐप से शुरू किए गए गेम सेव तभी सिंक करते हैं जब Secure Saves बंद हो।</string>
    <string name="setup_home_button_set">होम ऐप बनाएं</string>
