    <string name="settings_shell_modal_import_settings_title">要匯入設定嗎？</string>
    <string name="settings_shell_modal_import_settings_message">選擇備份檔案後，檔案中列出的設定會取代您目前的設定。檔案未包含的項目則不受影響，帳號、伺服器、同步狀態與檔案位置永遠不會被匯入。</string>
    <string name="settings_shell_modal_import_settings_confirm">選擇檔案</string>

