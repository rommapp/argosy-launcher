<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="160dp"
        android:height="90dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:startColor="#7986CB"
                android:endColor="#303F9F"
                android:angle="135" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/tv_banner_foreground"
        android:gravity="center"
        android:width="58dp"
        android:height="58dp" />
</layer-list>
