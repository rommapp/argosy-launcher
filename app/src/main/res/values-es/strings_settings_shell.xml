    <!-- ===== SettingsScreen: cache clear confirm modals ===== -->

    <string name="settings_shell_caches_image_title">¿Vaciar caché de imágenes?</string>
    <string name="settings_shell_caches_image_message">Esto eliminará todas las carátulas, fondos y capturas de pantalla en caché. Las imágenes se volverán a descargar del servidor mientras navegas.</string>
    <string name="settings_shell_caches_rom_extraction_title">¿Vaciar ROMs extraídas?</string>
    <string name="settings_shell_caches_rom_extraction_message">Esto eliminará las copias de trabajo extraídas de juegos comprimidos. Se volverán a extraer la próxima vez que se inicie cada juego.</string>
    <string name="settings_shell_caches_rom_staging_title">¿Vaciar preparación abandonada?</string>
    <string name="settings_shell_caches_rom_staging_message">Esto eliminará los archivos de trabajo internos dejados por descargas que nunca terminaron. Las descargas que aún están en cola conservan los suyos y continúan donde se quedaron.</string>
    <string name="settings_shell_caches_sfx_title">¿Vaciar caché de efectos de sonido?</string>
    <string name="settings_shell_caches_sfx_message">Esto eliminará los archivos de sonido personalizados transcodificados. Se reconstruyen automáticamente la próxima vez que se carguen los sonidos.</string>
    <string name="settings_shell_caches_emulator_apks_title">¿Vaciar instaladores de emuladores?</string>
    <string name="settings_shell_caches_emulator_apks_message">Esto eliminará los APK de instalación de emuladores descargados. Los emuladores instalados no se ven afectados.</string>
    <string name="settings_shell_caches_misc_downloads_title">¿Vaciar descargas varias?</string>
    <string name="settings_shell_caches_misc_downloads_message">Esto eliminará las imágenes de presencia de amigos y los paquetes de controladores GPU descargados. Los controladores instalados no se ven afectados.</string>
    <string name="settings_shell_caches_shaders_catalog_title">¿Vaciar catálogo de shaders?</string>
    <string name="settings_shell_caches_shaders_catalog_message">Esto eliminará los shaders del catálogo descargados. Los shaders personalizados se conservan, y los shaders del catálogo se vuelven a descargar bajo demanda.</string>
    <string name="settings_shell_caches_frames_title">¿Vaciar marcos descargados?</string>
    <string name="settings_shell_caches_frames_message">Esto eliminará los marcos descargados. Se volverán a descargar bajo demanda al seleccionarlos.</string>
    <string name="settings_shell_caches_steam_downloads_title">¿Vaciar datos de descarga de Steam?</string>
    <string name="settings_shell_caches_steam_downloads_message">Esto eliminará las descargas de Steam preparadas y vaciará la cola de descargas. Los juegos instalados no se ven afectados, pero las descargas parciales reiniciarán desde cero.</string>

