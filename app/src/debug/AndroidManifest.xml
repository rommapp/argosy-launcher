<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debugtools.DebugSeedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nendo.argosy.DEBUG_SEED_ROMM" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.nendo.argosy.debug.QuayPassTestHarness"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nendo.argosy.debug.QUAYPASS_DUMP_PUBKEY" />
                <action android:name="com.nendo.argosy.debug.QUAYPASS_DUMP_STATE" />
                <action android:name="com.nendo.argosy.debug.QUAYPASS_SEED" />
                <action android:name="com.nendo.argosy.debug.QUAYPASS_CLEAR_KEY" />
                <action android:name="com.nendo.argosy.debug.QUAYPASS_VERIFY" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".hardware.AudioTestReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nendo.argosy.TEST_AUDIO" />
                <action android:name="com.nendo.argosy.TOGGLE_AUDIO_LED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".hardware.AudioLevelDebugActivity"
            android:exported="true"
            android:theme="@style/Theme.Argosy" />
    </application>
</manifest>
