    <string name="settings_shell_modal_delete_core_confirm">刪除</string>

    <string name="settings_shell_modal_sync_saves_title">要同步存檔嗎？</string>
    <string name="settings_shell_modal_sync_saves_message">這會掃描所有已下載的遊戲以尋找存檔變更，並與伺服器同步。比上次同步更新的本機存檔會上傳，較新的伺服器存檔則會下載。</string>
