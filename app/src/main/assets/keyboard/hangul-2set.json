{
  "id": "hangul-2set",
  "version": 1,
  "script": "Hang",
  "locales": ["ko"],
  "composer": "hangul-2set",
  "pages": {
    "letters": {
      "shift": "none",
      "rows": [
        [{"k": "1", "s": "!"}, {"k": "2", "s": "@"}, {"k": "3", "s": "#"}, {"k": "4", "s": "$"}, {"k": "5", "s": "%"}, {"k": "6", "s": "^"}, {"k": "7", "s": "&"}, {"k": "8", "s": "*"}, {"k": "9", "s": "("}, {"k": "0", "s": ")"}],
        [{"k": "ㅂ", "s": "ㅃ"}, {"k": "ㅈ", "s": "ㅉ"}, {"k": "ㄷ", "s": "ㄸ"}, {"k": "ㄱ", "s": "ㄲ"}, {"k": "ㅅ", "s": "ㅆ"}, "ㅛ", "ㅕ", "ㅑ", {"k": "ㅐ", "s": "ㅒ"}, {"k": "ㅔ", "s": "ㅖ"}],
        [{"pad": 0.5}, "ㅁ", "ㄴ", "ㅇ", "ㄹ", "ㅎ", "ㅗ", "ㅓ", "ㅏ", "ㅣ", {"pad": 0.5}],
        [{"fn": "shift", "w": 1.5}, "ㅋ", "ㅌ", "ㅊ", "ㅍ", "ㅠ", "ㅜ", "ㅡ", {"fn": "backspace", "w": 1.5}]
      ]
    },
    "symbols": {"ref": "shared-symbols", "asciiOnly": true}
  },
  "accents": {
    "$": ["€", "£", "¥", "₹", "₩", "₽"]
  }
}
